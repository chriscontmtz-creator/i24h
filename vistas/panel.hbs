      return '<tr>' +
        '<td><div class="usr-uinfo"><div class="usr-av usr-av-rojo">' + ini + '</div>' +
          '<div><div class="usr-uname">' + (e.nombre||'—') + '</div>' +
          '<div class="usr-ucorreo">' + e.correo + '</div></div></div></td>' +
        '<td><span class="usr-role-badge ' + (USR_ROL_CLASS[e.cargo]||'') + '">' + (USR_ROL_LABEL[e.cargo]||e.cargo) + '</span></td>' +
        '<td>' + ((e.sucursales||[]).length
          ? (e.sucursales||[]).map(function(s){ return '<span class="usr-suc-tag">' + s + '</span>'; }).join('')
          : '<span style="font-size:.72rem;color:var(--texto-suave)">—</span>') + '</td>' +
        '<td style="font-size:.72rem;color:var(--texto-suave)">' + fecha + '</td>' +
        '<td style="font-size:.72rem;color:var(--texto-suave)">' + conn + '</td>' +
        '<td><div style="display:flex;align-items:center;gap:5px">' +
          '<div class="usr-tog ' + (e.activo?'on':'off') + '" onclick="usrToggleEstado(\'' + e._id + '\',\'emp\')">' +
            '<div class="usr-tog-t"></div></div>' +
          '<span class="usr-tog-label">' + (e.activo?'Activo':'Inactivo') + '</span>' +
        '</div></td>' +
        '<td><div class="usr-menu-wrap">' +
          '<button class="usr-act-btn" onclick="usrAbrirMenu(\'e' + e._id + '\')" aria-label="Acciones">' +
            '<i class="ti ti-dots-vertical" aria-hidden="true"></i></button>' +
          '<div class="usr-menu-dd" id="usr-menu-e' + e._id + '">' +
            '<div class="usr-mitem" onclick="usrEditarCargo(\'' + e._id + '\',\'' + nom + '\',\'' + e.cargo + '\')"><i class="ti ti-briefcase" aria-hidden="true"></i> Editar cargo</div>' +
            '<div class="usr-mitem" onclick="usrCambiarSucursales(\'' + e._id + '\',\'' + nom + '\',' + JSON.stringify(e.sucursales||[]) + ')"><i class="ti ti-building-store" aria-hidden="true"></i> Cambiar sucursales</div>' +
            '<div class="usr-mitem" onclick="usrCambiarPassword(\'' + e._id + '\',\'' + nom + '\')"><i class="ti ti-lock" aria-hidden="true"></i> Cambiar contrase\xF1a</div>' +
            '<div class="usr-mitem danger" onclick="usrCerrarMenu();usrEliminarUsuario(\'' + e._id + '\',\'' + nom + '\')"><i class="ti ti-trash" aria-hidden="true"></i> Eliminar cuenta</div>' +
