          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ creadoPor: 'admin' })
        });
        var datos = await res.json();
        if(!res.ok) { alert('Error al generar el c\xF3digo.'); return; }
        generados.push(datos.codigo);
      }
      alert('C\xF3digo' + (generados.length > 1 ? 's generados:' : ' generado:') + '\n\n' + generados.join('\n') + '\n\nEntr\xE9galos al cliente en sucursal. Son de un solo uso.');
      await usrCargarTodo();
    } catch(e) { alert('Error de conexi\xF3n.'); }
  });

  usrCargarTodo();
})();


// ============================================================
//  REPORTES DEPARTAMENTO
// ============================================================
(function () {
  var rptActiveDept   = 'all';
  var rptActiveSuc    = 'all';
  var rptActiveStatus = 'all';

  var rptDepts = { imp: 'Impresoras', mant: 'Mantenimiento', sis: 'Sistemas', bodega: 'Bodega' };
  var rptDias  = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
  var rptMeses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

  function rptPad(n) { return n.toString().padStart(2, '0'); }

  function rptGetNow() {
    var n = new Date();
    return {
      dia:   rptDias[n.getDay()],
      fecha: rptPad(n.getDate()) + '/' + rptPad(n.getMonth() + 1) + '/' + n.getFullYear(),
      hora:  rptPad(n.getHours()) + ':' + rptPad(n.getMinutes()),
      d:     rptPad(n.getDate()),
      mes:   rptMeses[n.getMonth()],
      y:     n.getFullYear()
    };
  }

  function rptTick() {
    var t  = rptGetNow();
    var e1 = document.getElementById('rpt-livetime');
    var e2 = document.getElementById('rpt-cardtime');
    if (e1) e1.textContent = t.dia + ', ' + t.d + ' ' + t.mes + ' ' + t.y + ' · ' + t.hora;
    if (e2) e2.textContent = t.fecha + ' · ' + t.hora;
  }

  rptTick();
  setInterval(rptTick, 30000);

  window.rptSelectDept = function (dept) {
    ['imp', 'mant', 'sis', 'bodega'].forEach(function (d) {
      var btn = document.getElementById('rpt-d-' + d);
      if (btn) btn.className = 'rpt-dept-btn';
    });
    var active = document.getElementById('rpt-d-' + dept);
    if (active) active.classList.add('active-' + dept);
    var extra = document.getElementById('rpt-extraFields');
    if (extra) extra.style.display = dept === 'imp' ? 'flex' : 'none';
  };

  function rptApplyFilters() {
    document.querySelectorAll('.rpt-card').forEach(function (c) {
      var dOk  = rptActiveDept   === 'all' || c.dataset.dept   === rptActiveDept;
      var sOk  = rptActiveSuc    === 'all' || c.dataset.suc    === rptActiveSuc;
      var stOk = rptActiveStatus === 'all' || c.dataset.status === rptActiveStatus;
      c.classList.toggle('hidden', !(dOk && sOk && stOk));
    });
  }

  window.rptFilterDept = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add(val === 'all' ? 'active-all' : 'active-' + val);
    rptActiveDept = val;
    rptApplyFilters();
  };

  window.rptFilterSuc = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add('active-suc');
    rptActiveSuc = val;
    rptApplyFilters();
  };

  window.rptFilterStatus = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add(val === 'all' ? 'active-all' : val === 'pendiente' ? 'active-pend' : 'active-done');
    rptActiveStatus = val;
    rptApplyFilters();
  };

  window.rptToggleStatus = function (btn) {
    var card   = btn.closest('.rpt-card');
    var isPend = card.dataset.status === 'pendiente';
    card.dataset.status = isPend ? 'realizado' : 'pendiente';
    card.classList.toggle('done', !isPend);
    btn.className = 'rpt-status-toggle ' + (isPend ? 'realizado' : 'pendiente');
    btn.innerHTML = isPend
      ? '<i class="ti ti-check" style="font-size:11px" aria-hidden="true"></i> Realizado'
      : '<i class="ti ti-clock" style="font-size:11px" aria-hidden="true"></i> Pendiente';
    rptApplyFilters();
  };

  window.rptCrearReporte = function () {
    var suc   = document.getElementById('rpt-sel-suc').value;
    var desc  = document.getElementById('rpt-inp-desc').value.trim();
    var t     = rptGetNow();
    var active = document.querySelector('[id^="rpt-d-"][class*="active"]');
    var dept  = active ? active.id.replace('rpt-d-', '') : 'imp';

    var lines = [suc, t.fecha, t.dia, '', 'REPORTE', '', rptDepts[dept], ''];
    if (dept === 'imp') {
      var marca = document.getElementById('rpt-inp-marca').value.trim();
      var num   = document.getElementById('rpt-inp-num').value.trim();
      if (marca) lines.push(marca);
      if (num)   { lines.push(''); lines.push('No. Impresora'); lines.push(num); }
      lines.push('');
    }
    lines.push(desc || 'Sin descripción.');
    lines.push('');
    lines.push('@Monitoreo');

    // Insertar tarjeta al inicio del feed
    var feed = document.getElementById('rpt-feed');
    var card = document.createElement('div');
    card.className        = 'rpt-card ' + dept;
    card.dataset.dept     = dept;
    card.dataset.suc      = suc;
    card.dataset.status   = 'pendiente';

    var numVal  = dept === 'imp' ? document.getElementById('rpt-inp-num').value.trim() : '';
    var impChip = numVal ? '<span class="rpt-printer-chip">' + numVal + '</span>' : '';

    card.innerHTML =
      '<div class="rpt-card-top">' +
        '<div class="rpt-card-meta">' +
          '<span class="rpt-dept-tag ' + dept + '">' + rptDepts[dept] + '</span>' +
          '<span class="rpt-suc-name">' + suc + '</span>' +
          '<span class="rpt-new-badge">nuevo</span>' +
        '</div>' +
        '<div class="rpt-card-right">' +
          '<span class="rpt-card-time">Ahora · ' + t.hora + '</span>' +
          '<button class="rpt-status-toggle pendiente" onclick="rptToggleStatus(this)" aria-label="Cambiar estado">' +
            '<i class="ti ti-clock" style="font-size:11px" aria-hidden="true"></i> Pendiente' +
          '</button>' +
        '</div>' +
      '</div>' +
      '<p class="rpt-card-desc">' + (desc || 'Sin descripción.') + '</p>' +
      '<div class="rpt-card-footer"><span class="rpt-mention">@Monitoreo</span>' + impChip + '</div>';

    feed.insertBefore(card, feed.firstChild);

    // Actualizar badge del menú
    var badge = document.querySelector('[data-seccion="reportes"] .panel-badge');
    if (badge) badge.textContent = parseInt(badge.textContent || '0') + 1;

    // Mostrar modal
    document.getElementById('rpt-msg-text').textContent = lines.join('\n');
    document.getElementById('rpt-overlay').classList.add('open');
    document.getElementById('rpt-copy-label').textContent = 'Copiar mensaje';
    document.getElementById('rpt-copy-icon').className    = 'ti ti-copy';

    // Limpiar formulario
    document.getElementById('rpt-inp-desc').value  = '';
    document.getElementById('rpt-inp-num').value   = '';
    document.getElementById('rpt-inp-marca').value = '';

    rptApplyFilters();
  };

  window.rptCopiarMensaje = function () {
    var txt = document.getElementById('rpt-msg-text').textContent;
    navigator.clipboard.writeText(txt).then(function () {
      document.getElementById('rpt-copy-label').textContent = '¡Copiado!';
      document.getElementById('rpt-copy-icon').className    = 'ti ti-check';
      setTimeout(function () {
        document.getElementById('rpt-copy-label').textContent = 'Copiar mensaje';
        document.getElementById('rpt-copy-icon').className    = 'ti ti-copy';
      }, 2500);
    }).catch(function () {
      document.getElementById('rpt-copy-label').textContent = 'Copia el texto arriba';
    });
  };

  window.rptCloseModal = function (e) {
    if (!e || e.target === document.getElementById('rpt-overlay')) {
      document.getElementById('rpt-overlay').classList.remove('open');
    }
  };

  // Cerrar modal con Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var overlay = document.getElementById('rpt-overlay');
      if (overlay && overlay.classList.contains('open')) overlay.classList.remove('open');
    }
  });
})();

// =============================================================
//  SECCIÓN VENTAS — lógica completa
// =============================================================
(function () {

  // Colores fijos de categoría
  var CAT_COLOR = { Novedades: '#7F77DD', Papelería: '#1D9E75', Snack: '#D85A30' };

  // Badge de sucursal: fondo y texto
  var SUC_BADGE = {
    'simon-bolivar': { bg: '#dbeafe', color: '#1e40af', label: 'S.Bolívar' },
    'insurgentes':   { bg: '#ede9fe', color: '#5b21b6', label: 'Insurgentes' },
    'antigona':      { bg: '#d1fae5', color: '#065f46', label: 'Antígona'  },
    'lincoln-oxxo':  { bg: '#fef3c7', color: '#92400e', label: 'L.Oxxo'    },
    'lincoln-2':     { bg: '#ffedd5', color: '#7c2d12', label: 'Lincoln 2'  },
    'ruiz-cortines': { bg: '#dbeafe', color: '#1e3a5f', label: 'R.Cortines' },
    'rodas':         { bg: '#ede9fe', color: '#4a1d96', label: 'Rodas'      },
    'cuauhtemoc':    { bg: '#d1fae5', color: '#064e3b', label: 'Cuauhtémoc' },
    'ordonez':       { bg: '#fef3c7', color: '#78350f', label: 'Ordóñez'    },
  };

  // Mapeo nombre de sucursal → id para los badges
  var SUC_NAME_TO_ID = {
    'Simón Bolívar': 'simon-bolivar', 'Insurgentes': 'insurgentes',
    'Antígona': 'antigona',           'Lincoln Oxxo': 'lincoln-oxxo',
    'Lincoln 2': 'lincoln-2',         'Ruiz Cortines': 'ruiz-cortines',
    'Rodas': 'rodas',                 'Cuauhtémoc': 'cuauhtemoc',
    'Ordóñez': 'ordonez',
  };

  var vntPeriodo  = '7';
  var vntSucursal = 'todas';
  var vntTopCat   = 'todas';
  var vntData     = null;
  var vntCargado  = false;

  function fmt(n) { return '$' + n.toLocaleString('es-MX'); }
  function fmtDelta(d) { return (d >= 0 ? '+' : '') + d.toFixed(1) + '%'; }

  // Pills de período
  document.querySelectorAll('.vnt-pill').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.vnt-pill').forEach(function (b) { b.classList.remove('active'); });
      this.classList.add('active');
      vntPeriodo = this.dataset.periodo;
      vntCargar();
    });
  });

  // Filtro de sucursal
  var vntSucSel = document.getElementById('vnt-suc-filter');
  if (vntSucSel) vntSucSel.addEventListener('change', function () {
    vntSucursal = this.value;
    vntCargar();
  });

  // Filtro de categoría en top productos
  var vntTopSel = document.getElementById('vnt-top-cat-filter');
  if (vntTopSel) vntTopSel.addEventListener('change', function () {
    vntTopCat = this.value;
    vntCargarTop();
  });

  // Exportar CSV
  var vntExpBtn = document.getElementById('vnt-export-btn');
  if (vntExpBtn) vntExpBtn.addEventListener('click', vntExportar);

  // Activar carga cuando se entra a la sección Ventas
  var vntNavBtn = document.querySelector('[data-seccion="ventas"]');
  if (vntNavBtn) vntNavBtn.addEventListener('click', function () {
    if (!vntCargado) vntCargar();
  });

  // ── carga principal ────────────────────────────────────────────────────────

  async function vntCargar() {
    try {
      var r = await fetch('/api/ventas?sucursal=' + vntSucursal + '&periodo=' + vntPeriodo);
      vntData    = await r.json();
      vntCargado = true;
      vntRenderKpis();
      vntRenderDesglose();
      vntRenderTabla();
      vntCargarTop();
      vntCargarAlertas();
    } catch (e) { console.error('Ventas:', e); }
  }

  // ── KPIs ───────────────────────────────────────────────────────────────────

  function vntRenderKpis() {
    if (!vntData) return;
    var d = vntData;
    var el = function (id) { return document.getElementById(id); };

    if (el('vnt-k-total'))       el('vnt-k-total').textContent   = fmt(d.totalGeneral);
    if (el('vnt-k-activas'))     el('vnt-k-activas').textContent  = d.desglose.length + ' / 9';
    if (el('vnt-k-top-suc') && d.topSucursal)  el('vnt-k-top-suc').textContent  = d.topSucursal.nombre;
    if (el('vnt-k-top-suc-val') && d.topSucursal) {
      el('vnt-k-top-suc-val').textContent = fmt(d.topSucursal.total);
      el('vnt-k-top-suc-val').style.color = 'var(--texto-suave)';
    }
    if (el('vnt-k-top-cat') && d.topCategoria) {
      el('vnt-k-top-cat').textContent    = d.topCategoria.nombre;
      el('vnt-k-top-cat').style.color    = CAT_COLOR[d.topCategoria.nombre] || 'var(--texto)';
    }
    if (el('vnt-k-top-cat-val') && d.topCategoria) {
      el('vnt-k-top-cat-val').textContent = fmt(d.topCategoria.total);
      el('vnt-k-top-cat-val').style.color = 'var(--texto-suave)';
    }
    if (el('vnt-k-delta')) {
      var pos = d.deltaPromedio >= 0;
      el('vnt-k-delta').textContent = fmtDelta(d.deltaPromedio) + ' vs período anterior';
      el('vnt-k-delta').className   = 'vnt-kpi-delta ' + (pos ? 'vnt-delta-pos' : 'vnt-delta-neg');
    }
  }

  // ── Desglose por sucursal (grid 3×3) ──────────────────────────────────────

  function vntRenderDesglose() {
    if (!vntData) return;
    var grid = document.getElementById('vnt-suc-grid');
    if (!grid) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];

    grid.innerHTML = vntData.desglose.map(function (suc) {
      var maxCat = Math.max.apply(null, cats.map(function (c) { return suc.categorias[c] || 0; }));
      var pos    = suc.delta >= 0;

      var barras = cats.map(function (cat) {
        var val = suc.categorias[cat] || 0;
        var pct = maxCat > 0 ? Math.round(val / maxCat * 100) : 0;
        var col = CAT_COLOR[cat];
        return '<div class="vnt-barra-row">' +
          '<span class="vnt-barra-label" style="color:' + col + '">' + cat + '</span>' +
          '<div class="vnt-barra-track">' +
            '<div class="vnt-barra-fill" style="width:' + pct + '%;background:' + col + '"></div>' +
          '</div>' +
          '<span class="vnt-barra-val">' + fmt(val) + '</span>' +
        '</div>';
      }).join('');

      var deltaHtml = pos
        ? '<span class="vnt-delta-pos">↑ ' + fmtDelta(suc.delta) + '</span>'
        : '<span class="vnt-delta-neg">↓ ' + fmtDelta(suc.delta) + '</span>';

      return '<div class="vnt-suc-card">' +
        '<div class="vnt-suc-card-head">' +
          '<span class="vnt-suc-card-nombre">' + suc.nombre + '</span>' +
          deltaHtml +
        '</div>' +
        '<div class="vnt-suc-card-total">' + fmt(suc.total) + '</div>' +
        barras +
      '</div>';
    }).join('');
  }

  // ── Tabla comparativa (3 cat × 9 suc) ─────────────────────────────────────

  function vntRenderTabla() {
    if (!vntData) return;
    var tabla = document.getElementById('vnt-tabla');
    if (!tabla) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];
    var sucs = vntData.desglose;

    // Abreviaciones para cabecera de columna
    var abr = function (n) {
      return n.replace('Simón Bolívar', 'S.Bolívar')
               .replace('Lincoln Oxxo', 'L.Oxxo')
               .replace('Lincoln 2',    'L.2')
               .replace('Ruiz Cortines','R.Cortines');
    };

    var html = '<thead><tr><th class="vnt-th-cat">Categoría</th>';
    sucs.forEach(function (s) { html += '<th>' + abr(s.nombre) + '</th>'; });
    html += '</tr></thead><tbody>';

    cats.forEach(function (cat) {
      var col    = CAT_COLOR[cat];
      var vals   = sucs.map(function (s) { return s.categorias[cat] || 0; });
      var maxVal = Math.max.apply(null, vals);

      html += '<tr><td><span class="vnt-cat-dot" style="background:' + col + '"></span>' + cat + '</td>';
      sucs.forEach(function (s) {
        var val   = s.categorias[cat] || 0;
        var ganó  = val === maxVal && maxVal > 0;
        html += '<td class="' + (ganó ? 'vnt-winner' : '') + '">' + (ganó ? '🏆 ' : '') + fmt(val) + '</td>';
      });
      html += '</tr>';
    });

    html += '</tbody>';
    tabla.innerHTML = html;
  }

  // ── Top productos ──────────────────────────────────────────────────────────

  async function vntCargarTop() {
    var tb = document.getElementById('vnt-top-body');
    if (!tb) return;
    tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Cargando…</td></tr>';
    try {
      var r    = await fetch('/api/ventas/top-productos?categoria=' + vntTopCat + '&periodo=' + vntPeriodo);
      var data = await r.json();
      if (!data.length) { tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Sin datos</td></tr>'; return; }
      tb.innerHTML = data.map(function (p, i) {
        var sid   = SUC_NAME_TO_ID[p.sucursal] || '';
        var badge = SUC_BADGE[sid] || { bg: '#f3f4f6', color: '#374151', label: p.sucursal };
        var catCol = CAT_COLOR[p.categoria] || '#666';
        return '<tr>' +
          '<td style="font-weight:700;color:var(--texto-suave);font-size:.75rem">' + (i + 1) + '</td>' +
          '<td>' +
            '<span style="font-size:.6rem;padding:2px 6px;border-radius:99px;background:' + catCol + '22;color:' + catCol + ';font-weight:700;margin-right:4px">' + p.categoria[0] + '</span>' +
            '<span style="font-size:.8rem">' + p.nombre + '</span>' +
          '</td>' +
          '<td><span style="font-size:.68rem;padding:2px 7px;border-radius:99px;background:' + badge.bg + ';color:' + badge.color + ';font-weight:600">' + badge.label + '</span></td>' +
          '<td style="text-align:right;font-size:.8rem;font-weight:600">' + p.unidades.toLocaleString('es-MX') + '</td>' +
          '<td style="text-align:right;font-size:.8rem;font-weight:700;color:var(--texto)">' + fmt(p.venta) + '</td>' +
        '</tr>';
      }).join('');
    } catch (e) {
      tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Error al cargar</td></tr>';
    }
  }

  // ── Alertas de rotación ────────────────────────────────────────────────────

  async function vntCargarAlertas() {
    var lista = document.getElementById('vnt-alertas-list');
    if (!lista) return;
    try {
      var r    = await fetch('/api/ventas/alertas');
      var data = await r.json();
      if (!data.length) {
        lista.innerHTML = '<div class="vnt-alerta-empty"><i class="ti ti-checks"></i><span>Sin alertas activas</span></div>';
        return;
      }
      lista.innerHTML = data.map(function (a) {
        var peligro = a.tipo === 'quiebre';
        return '<div class="vnt-alerta-card ' + (peligro ? 'vnt-alerta-danger' : 'vnt-alerta-warning') + '">' +
          '<div class="vnt-alerta-ico">' +
            (peligro ? '<i class="ti ti-flame"></i>' : '<i class="ti ti-package"></i>') +
          '</div>' +
          '<div class="vnt-alerta-body">' +
            '<p class="vnt-alerta-prod">' + a.producto + '</p>' +
            '<p class="vnt-alerta-meta">' + a.sucursal + ' · Stock: ' + a.stock + ' · ' + a.vendidos7 + ' uds/7d</p>' +
            '<p class="vnt-alerta-msg">' + a.mensaje + '</p>' +
          '</div>' +
          '<span class="vnt-alerta-tag">' + (peligro ? 'Quiebre' : 'Estancada') + '</span>' +
        '</div>';
      }).join('');
    } catch (e) {
      lista.innerHTML = '<div class="vnt-alerta-empty">Error al cargar alertas</div>';
    }
  }

  // ── Exportar CSV ───────────────────────────────────────────────────────────

  function vntExportar() {
    if (!vntData) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];
    var csv  = 'Sucursal,' + cats.join(',') + ',Total\n';
    vntData.desglose.forEach(function (s) {
      var vals = cats.map(function (c) { return s.categorias[c] || 0; });
      csv += s.nombre + ',' + vals.join(',') + ',' + s.total + '\n';
    });
    var blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href   = url;
    a.download = 'ventas_' + vntPeriodo + 'd.csv';
    a.click();
    URL.revokeObjectURL(url);
  }

})();
</script>
