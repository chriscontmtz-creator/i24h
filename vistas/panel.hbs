const CAUSAS_SOBRA = ['Selecciona causa…','Error conteo turno anterior','Devolución no registrada','Material Encontrado','Otro'];

var conteosBitacora = {};
var bitacoraIniciada = false;

// ── render ──────────────────────────────────────────────────────────────

function renderBitacora() {
  var cont = document.getElementById('bit-categorias');
  if (!cont) return;
  var html = '';

  PRODUCTOS_BITACORA.forEach(function(cat, ci) {
    var contados = cat.items.filter(function(_, ii) {
      return conteosBitacora[ci + '_' + ii] && conteosBitacora[ci + '_' + ii].valor !== null;
    }).length;

    html += '<div class="bit-cat-bloque">' +
      '<div class="bit-cat-head">' +
        '<i class="ti ' + cat.icono + '" style="font-size:16px;color:var(--acento)"></i>' +
        '<span class="bit-cat-titulo">' + cat.cat + '</span>' +
        '<span class="bit-cat-contador">' + contados + ' / ' + cat.items.length + '</span>' +
      '</div>' +
      '<div class="bit-col-headers">' +
        '<span class="bit-col-h">Producto</span>' +
        '<span class="bit-col-h">Esperado</span>' +
        '<span class="bit-col-h">Conteo</span>' +
        '<span class="bit-col-h">Diferencia</span>' +
      '</div>';

    cat.items.forEach(function(item, ii) {
      var key    = ci + '_' + ii;
      var estado = conteosBitacora[key];
      var val    = estado ? estado.valor : null;
      var diff   = val !== null ? val - item.esperado : null;
      var bClass = val === null ? 'bit-badge-vacio'
                 : diff === 0  ? 'bit-badge-ok'
                 : diff < 0    ? 'bit-badge-falta'
                               : 'bit-badge-sobra';
      var bText  = val === null ? '—'
                 : diff === 0  ? '✓ OK'
                 : diff < 0    ? (item.esperado + ' − ' + val + ' = −' + Math.abs(diff))
                               : (val + ' − ' + item.esperado + ' = +' + diff);
      var dis    = bitacoraIniciada ? '' : ' disabled';

      html += '<div class="bit-prod-fila">' +
        '<span class="bit-prod-nombre">' + item.nombre + '</span>' +
        '<span class="bit-prod-esperado">' + item.esperado + '</span>' +
        '<div class="bit-conteo-wrap">' +
          '<button class="bit-cbtn" data-key="' + key + '" data-esp="' + item.esperado + '" data-delta="-1"' + dis + '>−</button>' +
          '<input class="bit-cinp" type="number" min="0"' +
            ' value="' + (val !== null ? val : '') + '"' +
            ' placeholder="—"' +
            ' data-key="' + key + '" data-esp="' + item.esperado + '"' + dis + '>' +
          '<button class="bit-cbtn" data-key="' + key + '" data-esp="' + item.esperado + '" data-delta="1"' + dis + '>+</button>' +
          '<button class="bit-cbtn bit-cbtn-ok" data-key="' + key + '" data-esp="' + item.esperado + '" data-ok="1"' + dis + ' title="Sin diferencia">✓</button>' +
        '</div>' +
        '<span class="bit-badge ' + bClass + '">' + bText + '</span>' +
      '</div>';

      if (val !== null && diff !== 0) {
        var causas = diff < 0 ? CAUSAS_FALTA : CAUSAS_SOBRA;
        html += '<div class="bit-justif-fila">' +
          '<span class="bit-justif-label"><i class="ti ti-alert-circle"></i> Justificación</span>' +
          '<select class="bit-justif-select" data-key="' + key + '">' +
            causas.map(function(c) {
              return '<option value="' + c + '"' + (estado.justif === c ? ' selected' : '') + '>' + c + '</option>';
            }).join('') +
          '</select>' +
        '</div>';
      }
    });
    html += '</div>';
  });

  cont.innerHTML = html;

  // ── listeners directos tras cada render ────────────────────────────────
  if (bitacoraIniciada) {
    cont.querySelectorAll('[data-delta]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        var dlt = +this.dataset.delta;
        var act = conteosBitacora[k].valor !== null ? conteosBitacora[k].valor : esp;
        conteosBitacora[k].valor = Math.max(0, act + dlt);
        if (conteosBitacora[k].valor === esp) conteosBitacora[k].justif = '';
        renderBitacora();
      });
    });

    cont.querySelectorAll('[data-ok]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        conteosBitacora[k].valor = esp;
        conteosBitacora[k].justif = '';
        renderBitacora();
      });
    });

    cont.querySelectorAll('.bit-cinp').forEach(function(inp) {
      inp.addEventListener('input', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        var n   = parseInt(this.value);
        if (!isNaN(n) && n >= 0) {
          conteosBitacora[k].valor = n;
          if (n === esp) conteosBitacora[k].justif = '';
          var fila  = this.closest('.bit-prod-fila');
          var badge = fila ? fila.querySelector('.bit-badge') : null;
          if (badge) {
            var d = n - esp;
            badge.className   = 'bit-badge ' + (d === 0 ? 'bit-badge-ok' : d < 0 ? 'bit-badge-falta' : 'bit-badge-sobra');
            badge.textContent = d === 0 ? '✓ OK' : d < 0 ? (esp + ' − ' + n + ' = −' + Math.abs(d)) : (n + ' − ' + esp + ' = +' + d);
          }
          actualizarResumen();
        }
      });
    });

    cont.querySelectorAll('.bit-justif-select').forEach(function(sel) {
      sel.addEventListener('change', function() {
        conteosBitacora[this.dataset.key].justif = this.value;
      });
    });
  }

  actualizarResumen();
}

// ── resumen de la barra superior ─────────────────────────────────────────

function actualizarResumen() {
  var ok = 0, falta = 0, sobra = 0, pendiente = 0;
  var total = Object.keys(conteosBitacora).length;

  Object.keys(conteosBitacora).forEach(function(key) {
    var estado = conteosBitacora[key];
    if (estado.valor === null) { pendiente++; return; }
    var partes = key.split('_');
    var ii = parseInt(partes[1]);
    var ci = parseInt(partes[0]);
    var cat  = PRODUCTOS_BITACORA[ci];
    var item = cat ? cat.items[ii] : null;
    if (!item) return;
    var diff = estado.valor - item.esperado;
    if (diff === 0) ok++; else if (diff < 0) falta++; else sobra++;
  });

  var contados = ok + falta + sobra;
  document.getElementById('res-ok').textContent        = ok;
  document.getElementById('res-falta').textContent     = falta;
  document.getElementById('res-sobra').textContent     = sobra;
  document.getElementById('res-pendiente').textContent = pendiente;
  var pct = total > 0 ? Math.round(contados / total * 100) : 0;
  document.getElementById('bit-prog-fill').style.width = pct + '%';
  document.getElementById('bit-prog-txt').textContent  = contados + ' / ' + total + ' productos';
}

// ── iniciar / cerrar bitácora ─────────────────────────────────────────────

document.getElementById('btn-iniciar-conteo')?.addEventListener('click', function() {
  bitacoraIniciada = true;
  this.innerHTML = '<i class="ti ti-check"></i> Conteo activo';
  this.style.background = '#16a34a';
  this.disabled = true;
  renderBitacora();
});

document.getElementById('btn-cerrar-bitacora')?.addEventListener('click', function() {
  var pendiente = parseInt(document.getElementById('res-pendiente').textContent);
  if (pendiente > 0) {
    alert('Aún tienes ' + pendiente + ' productos sin contar. Completa el conteo antes de cerrar.');
    return;
  }
  if (confirm('¿Confirmas que quieres cerrar la bitácora de este turno? No podrás modificarla después.')) {
    alert('Bitácora cerrada. Los datos se guardarán cuando el sistema esté conectado a la base de datos.');
  }
});

// ── arranque ──────────────────────────────────────────────────────────────

(function inicializarConteos() {
  PRODUCTOS_BITACORA.forEach(function(cat, ci) {
    cat.items.forEach(function(item, ii) {
      conteosBitacora[ci + '_' + ii] = { valor: null, justif: '' };
    });
  });
})();

renderBitacora();

// =============================================================
//  SECCIÓN USUARIOS
// =============================================================

(function() {
  let usrTab = 'emp';
  let usrMenuAbierto = null;
  let usrBusqueda = '', usrFiltroRol = '', usrFiltroSuc = '', usrFiltroEst = '', usrFiltroCod = '', usrFiltroPts = '';

  const USR_ROL_CLASS = { admin:'rb-admin', coordinador:'rb-coord', lider:'rb-lider', encargado:'rb-encarg', colaborador:'rb-colab' };
  const USR_ROL_LABEL = { admin:'Admin', coordinador:'Coordinador', lider:'Líder', encargado:'Encargado', colaborador:'Colaborador' };

  const SUCURSALES = ['Simón Bolívar','Insurgentes','Antígona','Lincoln Oxxo','Lincoln 2','Ruiz Cortines','Rodas','Cuauhtémoc','Ordóñez'];

  let usrEmpleados = [];
  let usrClientes  = [];
  let usrCodigos   = [];

  async function usrCargarTodo() {
    try {
      const [rEmp, rCli, rCod] = await Promise.all([
        fetch('/api/empleados'),
        fetch('/api/clientes'),
        fetch('/api/codigos')
      ]);
      usrEmpleados = await rEmp.json();
      usrClientes  = await rCli.json();
      usrCodigos   = await rCod.json();
    } catch(e) {
      usrEmpleados = [];
      usrClientes  = [];
      usrCodigos   = [];
    }
    usrActualizarStats();
    usrRenderFiltros();
    usrRenderAll();
  }

  function usrActualizarStats() {
    const ahora     = new Date();
    const inicioMes = new Date(ahora.getFullYear(), ahora.getMonth(), 1);
    const activos   = usrEmpleados.filter(function(e) { return e.activo; }).length;
    const inacEmp   = usrEmpleados.filter(function(e) { return !e.activo; }).length;
    const inacCli   = usrClientes.filter(function(c)  { return !c.activo; }).length;
    const codDis    = usrCodigos.filter(function(c)   { return !c.usado; }).length;
    const codUsa    = usrCodigos.filter(function(c)   { return c.usado; }).length;
    const cliMes    = usrClientes.filter(function(c)  { return c.fechaCreacion && new Date(c.fechaCreacion) >= inicioMes; }).length;
    const el = function(id) { return document.getElementById(id); };
    if(el('usr-cnt-emp-tot'))  el('usr-cnt-emp-tot').textContent  = usrEmpleados.length;
    if(el('usr-cnt-emp-act'))  el('usr-cnt-emp-act').textContent  = activos + ' activos';
    if(el('usr-cnt-cli-tot'))  el('usr-cnt-cli-tot').textContent  = usrClientes.length;
    if(el('usr-cnt-cli-mes'))  el('usr-cnt-cli-mes').textContent  = 'Este mes: ' + cliMes;
    if(el('usr-cnt-cod-dis'))  el('usr-cnt-cod-dis').textContent  = codDis;
    if(el('usr-cnt-cod-usa'))  el('usr-cnt-cod-usa').textContent  = codUsa + ' usados';
    if(el('usr-cnt-inac'))     el('usr-cnt-inac').textContent     = inacEmp + inacCli;
    if(el('usr-tcnt-emp'))     el('usr-tcnt-emp').textContent     = usrEmpleados.length;
    if(el('usr-tcnt-cli'))     el('usr-tcnt-cli').textContent     = usrClientes.length;
    if(el('usr-tcnt-cod'))     el('usr-tcnt-cod').textContent     = usrCodigos.length;
  }

  function usrEmpFiltrados() {
    return usrEmpleados.filter(e => {
      const q = usrBusqueda.toLowerCase();
      if(q && !(e.nombre||'').toLowerCase().includes(q) && !(e.correo||'').toLowerCase().includes(q)) return false;
      if(usrFiltroRol && e.cargo !== usrFiltroRol) return false;
      if(usrFiltroSuc && !(e.sucursales||[]).includes(usrFiltroSuc)) return false;
      if(usrFiltroEst === '1' && !e.activo) return false;
      if(usrFiltroEst === '0' && e.activo)  return false;
      return true;
    });
  }

  function usrCliFiltrados() {
    return usrClientes.filter(c => {
      const q = usrBusqueda.toLowerCase();
      if(q && !(c.correo||'').toLowerCase().includes(q)) return false;
      if(usrFiltroEst === '1' && !c.activo) return false;
      if(usrFiltroEst === '0' && c.activo)  return false;
      if(usrFiltroPts === 'alto'  && (c.puntos||0) <= 500) return false;
      if(usrFiltroPts === 'medio' && ((c.puntos||0) < 100 || (c.puntos||0) > 500)) return false;
      if(usrFiltroPts === 'bajo'  && (c.puntos||0) >= 100) return false;
      return true;
    });
  }

  function usrCodFiltrados() {
    return usrCodigos.filter(c => {
      if(usrFiltroCod === '0' && c.usado)  return false;
      if(usrFiltroCod === '1' && !c.usado) return false;
      return true;
    });
  }

  function usrSetTab(t) {
    usrTab = t;
    usrBusqueda = ''; usrFiltroRol = ''; usrFiltroSuc = ''; usrFiltroEst = ''; usrFiltroCod = ''; usrFiltroPts = '';
    ['emp','cli','cod'].forEach(x => {
      const tab = document.getElementById('usr-tab-'+x);
      const vista = document.getElementById('usr-vista-'+x);
      if(tab)   tab.className   = 'usr-tab' + (t === x ? ' active' : '');
      if(vista) vista.style.display = t === x ? '' : 'none';
    });
    usrCerrarMenu();
    usrRenderFiltros();
    usrRenderAll();
  }
  window.usrSetTab = usrSetTab;

  function usrRenderFiltros() {
    const wrap = document.getElementById('usr-filtros-dinamicos');
    const cnt  = document.getElementById('usr-filter-count');
    if(!wrap) return;

    const hayFiltros = usrBusqueda || usrFiltroRol || usrFiltroSuc || usrFiltroEst || usrFiltroCod || usrFiltroPts;
    const btnLimpiar = hayFiltros
      ? '<button class="usr-btn-limpiar" onclick="usrBusqueda=\'\';usrFiltroRol=\'\';usrFiltroSuc=\'\';usrFiltroEst=\'\';usrFiltroCod=\'\';usrFiltroPts=\'\';usrRenderFiltros();usrRenderAll();">' +
          '<i class="ti ti-x" aria-hidden="true"></i> Limpiar filtros' +
        '</button>'
      : '';

    if(usrTab === 'emp') {
      const sucOpts = SUCURSALES.map(function(s) { return '<option value="' + s + '"' + (usrFiltroSuc===s?' selected':'') + '>' + s + '</option>'; }).join('');
      wrap.innerHTML =
        '<div class="usr-search-wrap">' +
          '<i class="ti ti-search" aria-hidden="true"></i>' +
          '<input class="usr-sinp" placeholder="Nombre o correo…" value="' + usrBusqueda + '" oninput="usrBusqueda=this.value;usrRenderAll()">' +
        '</div>' +
        '<select class="usr-fsel" onchange="usrFiltroRol=this.value;usrRenderAll()">' +
          '<option value="">Todos los cargos</option>' +
          '<option value="admin"' + (usrFiltroRol==='admin'?' selected':'') + '>Admin</option>' +
          '<option value="coordinador"' + (usrFiltroRol==='coordinador'?' selected':'') + '>Coordinador</option>' +
          '<option value="lider"' + (usrFiltroRol==='lider'?' selected':'') + '>L\xEDder</option>' +
          '<option value="encargado"' + (usrFiltroRol==='encargado'?' selected':'') + '>Encargado</option>' +
          '<option value="colaborador"' + (usrFiltroRol==='colaborador'?' selected':'') + '>Colaborador</option>' +
        '</select>' +
        '<select class="usr-fsel" onchange="usrFiltroSuc=this.value;usrRenderAll()">' +
          '<option value="">Todas las sucursales</option>' + sucOpts +
        '</select>' +
        '<select class="usr-fsel" onchange="usrFiltroEst=this.value;usrRenderAll()">' +
          '<option value="">Activos e inactivos</option>' +
          '<option value="1"' + (usrFiltroEst==='1'?' selected':'') + '>Solo activos</option>' +
          '<option value="0"' + (usrFiltroEst==='0'?' selected':'') + '>Solo inactivos</option>' +
        '</select>' + btnLimpiar;
      if(cnt) cnt.textContent = usrEmpFiltrados().length + ' de ' + usrEmpleados.length;

    } else if(usrTab === 'cli') {
      wrap.innerHTML =
        '<div class="usr-search-wrap">' +
          '<i class="ti ti-search" aria-hidden="true"></i>' +
          '<input class="usr-sinp" placeholder="Buscar por correo…" value="' + usrBusqueda + '" oninput="usrBusqueda=this.value;usrRenderAll()">' +
        '</div>' +
        '<select class="usr-fsel" onchange="usrFiltroEst=this.value;usrRenderAll()">' +
          '<option value="">Todos los estados</option>' +
          '<option value="1"' + (usrFiltroEst==='1'?' selected':'') + '>Solo activos</option>' +
          '<option value="0"' + (usrFiltroEst==='0'?' selected':'') + '>Solo inactivos</option>' +
        '</select>' +
        '<select class="usr-fsel" onchange="usrFiltroPts=this.value;usrRenderAll()">' +
          '<option value="">Todos los puntos</option>' +
          '<option value="alto"' + (usrFiltroPts==='alto'?' selected':'') + '>M\xE1s de 500 pts</option>' +
          '<option value="medio"' + (usrFiltroPts==='medio'?' selected':'') + '>100 – 500 pts</option>' +
          '<option value="bajo"' + (usrFiltroPts==='bajo'?' selected':'') + '>Menos de 100 pts</option>' +
        '</select>' + btnLimpiar;
      if(cnt) cnt.textContent = usrCliFiltrados().length + ' de ' + usrClientes.length;

    } else {
      wrap.innerHTML =
        '<select class="usr-fsel" onchange="usrFiltroCod=this.value;usrRenderAll()">' +
          '<option value="">Todos los c\xF3digos</option>' +
          '<option value="0"' + (usrFiltroCod==='0'?' selected':'') + '>Solo disponibles</option>' +
          '<option value="1"' + (usrFiltroCod==='1'?' selected':'') + '>Solo usados</option>' +
        '</select>' + btnLimpiar;
      if(cnt) cnt.textContent = usrCodFiltrados().length + ' de ' + usrCodigos.length;
    }
  }
  window.usrRenderFiltros = usrRenderFiltros;

  function usrAbrirMenu(id) {
    usrCerrarMenu();
    const m = document.getElementById('usr-menu-' + id);
    if(m) { m.classList.add('open'); usrMenuAbierto = id; }
  }
  window.usrAbrirMenu = usrAbrirMenu;

  function usrCerrarMenu() {
    if(usrMenuAbierto !== null) {
      const m = document.getElementById('usr-menu-' + usrMenuAbierto);
      if(m) m.classList.remove('open');
      usrMenuAbierto = null;
    }
  }
  window.usrCerrarMenu = usrCerrarMenu;

  document.addEventListener('click', function(e) { if(!e.target.closest('.usr-menu-wrap')) usrCerrarMenu(); });

  async function usrToggleEstado(id, tipo) {
    try {
      const res = await fetch('/api/usuarios/' + id + '/estado', { method: 'PATCH' });
      if (!res.ok) {
        const err = await res.json();
        alert(err.error || 'No se pudo cambiar el estado.');
        return;
      }
      await usrCargarTodo();
    } catch(e) {
      alert('Error de conexión al cambiar el estado.');
    }
  }
  window.usrToggleEstado = usrToggleEstado;

  async function usrEliminarUsuario(id, nombre) {
    if (!confirm('¿Eliminar la cuenta de "' + nombre + '"?\nEsta acción no se puede deshacer.')) return;
    try {
      const res = await fetch('/api/usuarios/' + id, { method: 'DELETE' });
      if (!res.ok) {
        const err = await res.json();
        alert(err.error || 'No se pudo eliminar la cuenta.');
        return;
      }
      await usrCargarTodo();
    } catch(e) {
      alert('Error de conexión al eliminar.');
    }
  }
  window.usrEliminarUsuario = usrEliminarUsuario;

  function usrRenderEmpleados() {
    const tb = document.getElementById('usr-tbody-emp');
    if(!tb) return;
    const lista = usrEmpFiltrados();
    if(!lista.length) { tb.innerHTML = '<tr><td colspan="7" class="usr-empty">No hay empleados que coincidan con los filtros</td></tr>'; return; }
    tb.innerHTML = lista.map(function(e) {
