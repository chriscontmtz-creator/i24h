     NAVEGACIÓN DEL SIDEBAR
     ============================================================ -->
<script>
(function () {
  var sucursalActiva = null;

  const items     = document.querySelectorAll('.panel-nav-item');
  const secciones = document.querySelectorAll('.panel-seccion');
  const titulo    = document.getElementById('panel-titulo');
  const sucPill   = document.querySelector('.panel-suc-pill');

  function activarSeccion(id, nombre) {
    items.forEach(function (i) { i.classList.remove('active'); });
    var item = document.querySelector('[data-seccion="' + id + '"]');
    if (item) item.classList.add('active');

    secciones.forEach(function (s) { s.classList.add('oculta'); });
    var target = document.getElementById('sec-' + id);
    if (target) target.classList.remove('oculta');

    titulo.textContent = nombre || (item ? item.dataset.titulo : id);
  }

  // Función global — la usan los botones onclick en las tarjetas de sucursales
  window.irSeccion = function (id, sucursal) {
    sucursalActiva = sucursal || null;
    var nombre = document.querySelector('[data-seccion="' + id + '"]')?.dataset.titulo || id;
    activarSeccion(id, nombre);
    if (sucPill && sucursalActiva) {
      sucPill.innerHTML = '<i class="ti ti-building-store"></i> ' + sucursalActiva;
    }
  };

  items.forEach(function (item) {
    item.addEventListener('click', function () {
      sucursalActiva = null;
      if (sucPill) sucPill.innerHTML = '<i class="ti ti-building-store"></i> Todas las sucursales';
      activarSeccion(item.dataset.seccion, item.dataset.titulo);
    });
  });
})();


