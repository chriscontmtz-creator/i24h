    var nombre     = document.getElementById('usr-reg-nombre').value.trim();
    var correo     = document.getElementById('usr-reg-correo').value.trim();
    var cargo      = document.getElementById('usr-reg-cargo').value;
    var pass       = document.getElementById('usr-reg-pass').value;
    var pass2      = document.getElementById('usr-reg-pass2').value;
    var msg        = document.getElementById('usr-reg-msg');
    var sucursales = Array.from(document.querySelectorAll('#usr-reg-suc-wrap input:checked')).map(function(cb){ return cb.value; });

    var mostrarMsg = function(txt, tipo) {
      msg.textContent = txt;
      msg.style.display = '';
      var oscuro = document.body.classList.contains('dark');
      msg.style.background = tipo === 'error' ? (oscuro ? '#450a0a' : '#fee2e2') : (oscuro ? '#052e16' : '#dcfce7');
      msg.style.color      = tipo === 'error' ? (oscuro ? '#fca5a5' : '#991b1b') : (oscuro ? '#4ade80' : '#166534');
    };

    if(!nombre||!correo||!pass) return mostrarMsg('Completa todos los campos obligatorios.','error');
    if(pass.length < 6)         return mostrarMsg('La contrase\xF1a debe tener al menos 6 caracteres.','error');
    if(pass !== pass2)          return mostrarMsg('Las contrase\xF1as no coinciden.','error');

    try {
      var res = await fetch('/api/empleados', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ correo: correo, password: pass, nombre: nombre, cargo: cargo, sucursales: sucursales })
      });
      var datos = await res.json();
      if(!res.ok) return mostrarMsg(datos.error || 'Error al crear la cuenta.','error');
      mostrarMsg('\xA1Cuenta creada correctamente!','ok');
      setTimeout(function() {
        usrCerrarDrawer();
        msg.style.display = 'none';
        document.getElementById('usr-reg-nombre').value = '';
        document.getElementById('usr-reg-correo').value = '';
        document.getElementById('usr-reg-pass').value   = '';
        document.getElementById('usr-reg-pass2').value  = '';
        document.querySelectorAll('#usr-reg-suc-wrap input').forEach(function(cb){ cb.checked = false; });
      }, 1500);
      await usrCargarTodo();
    } catch(e) { mostrarMsg('Error de conexi\xF3n con el servidor.','error'); }
  });

