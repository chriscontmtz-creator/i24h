<script>
function escHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
// Para valores insertados dentro de un onclick="...('valor')" — string JS
// entre comillas simples, anidado en un atributo HTML entre comillas dobles.
function escJs(str) {
  return String(str == null ? '' : str)
    .replace(/\\/g, '\\\\')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, "\\'");
}
</script>

<script>
(function() {
  var perfilTurnoSel = null;

  function perfilAbrirModal() {
    fetch('/api/sesion').then(function(r) { return r.json(); }).then(function(u) {
      if (!u) return;
      var inp = document.getElementById('perfil-nombre');
      var sub = document.getElementById('perfil-correo-sub');
      var msg = document.getElementById('perfil-msg');
      if (inp) inp.value = u.nombre || '';
      if (sub) sub.textContent = u.correo || '';
      if (msg) msg.style.display = 'none';
      perfilTurnoSel = u.turno || null;
      perfilActualizarBtns();
      document.getElementById('perfil-modal-bg').classList.add('open');
    }).catch(function() {});
  }
  window.perfilAbrirModal = perfilAbrirModal;

  function perfilCerrarModal() {
    document.getElementById('perfil-modal-bg').classList.remove('open');
  }
  window.perfilCerrarModal = perfilCerrarModal;

  function perfilActualizarBtns() {
    document.querySelectorAll('#perfil-turno-opts .perfil-turno-btn').forEach(function(btn) {
      btn.classList.toggle('em-active', (btn.dataset.turno || null) === perfilTurnoSel);
    });
  }

  document.querySelectorAll('#perfil-turno-opts .perfil-turno-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      perfilTurnoSel = btn.dataset.turno || null;
      perfilActualizarBtns();
    });
  });

  async function perfilGuardar() {
    var nombre = (document.getElementById('perfil-nombre').value || '').trim();
    var msg = document.getElementById('perfil-msg');
    if (!nombre) {
      msg.textContent = 'El nombre no puede estar vacío.';
      msg.className = 'error-msg error';
      msg.style.display = 'block';
      return;
    }
    try {
      var res = await fetch('/api/mi-perfil', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre: nombre, turno: perfilTurnoSel }),
      });
      var datos = await res.json();
      if (!res.ok) {
        msg.textContent = datos.error || 'Error al guardar.';
        msg.className = 'error-msg error';
        msg.style.display = 'block';
        return;
      }
      var elNom = document.querySelector('.panel-sidebar-nombre');
      var elAv  = document.querySelector('.panel-sidebar-avatar');
      if (elNom) elNom.textContent = datos.nombre;
      if (elAv)  elAv.textContent  = (datos.nombre || '?')[0].toUpperCase();
      perfilCerrarModal();
    } catch(e) {
      msg.textContent = 'Error de conexión.';
      msg.className = 'error-msg error';
      msg.style.display = 'block';
    }
  }
  window.perfilGuardar = perfilGuardar;
})();
</script>

