  // ── exportar CSV ────────────────────────────────────────────────────────
  function usrExportarCSV() {
    var rows, filename;
    if(usrTab === 'emp') {
      rows = usrEmpFiltrados().map(function(e) {
        return [
          '"' + (e.nombre||'').replace(/"/g,'""') + '"',
          '"' + (e.correo||'').replace(/"/g,'""') + '"',
          e.cargo||'',
          '"' + (e.sucursales||[]).join(', ').replace(/"/g,'""') + '"',
          e.activo ? 'Activo' : 'Inactivo',
          e.fechaCreacion ? new Date(e.fechaCreacion).toLocaleDateString('es-MX') : ''
        ].join(',');
      });
      rows.unshift('Nombre,Correo,Cargo,Sucursales,Estado,Registro');
      filename = 'empleados.csv';
    } else if(usrTab === 'cli') {
      rows = usrCliFiltrados().map(function(c) {
        return [
          '"' + (c.correo||'').replace(/"/g,'""') + '"',
          c.puntos||0,
          (c.canjes||[]).length,
          c.activo ? 'Activo' : 'Inactivo',
          c.fechaCreacion ? new Date(c.fechaCreacion).toLocaleDateString('es-MX') : ''
        ].join(',');
      });
      rows.unshift('Correo,Puntos,Canjes,Estado,Registro');
      filename = 'clientes.csv';
    } else {
      rows = usrCodFiltrados().map(function(c) {
        return [
          '"' + (c.codigo||'').replace(/"/g,'""') + '"',
          c.usado ? 'Usado' : 'Disponible',
          '"' + (c.creadoPor||'').replace(/"/g,'""') + '"',
          c.fecha ? new Date(c.fecha).toLocaleDateString('es-MX') : ''
        ].join(',');
      });
      rows.unshift('C\xF3digo,Estado,Creado por,Fecha');
      filename = 'codigos.csv';
    }
    var blob = new Blob(['﻿' + rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url);
  }
  window.usrExportarCSV = usrExportarCSV;

