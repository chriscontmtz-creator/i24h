          </select>
        </div>
        <div class="vsm-filtro-grupo">
          <label for="vsm-tk-nticket">Número de ticket</label>
          <input type="number" id="vsm-tk-nticket" class="vsm-input" min="1" placeholder="Ej: 10234">
        </div>
        <button class="vsm-btn-cargar" id="vsm-tk-btn-buscar">
          <i class="ti ti-search"></i> Buscar
        </button>
      </div>

      <div id="vsm-tk-estado" class="vsm-estado hidden"></div>

      <div id="vsm-tk-resultado" class="vsm-tk-resultado hidden">
        <div class="vsm-tk-info">
          <span>Ticket <strong id="vsm-tk-info-num">—</strong></span>
          <span>Importe total: <strong id="vsm-tk-info-importe">—</strong></span>
          <span>Fecha: <strong id="vsm-tk-info-fecha">—</strong></span>
        </div>

        <div class="vsm-tk-form">
          <div class="vsm-filtro-grupo">
            <label for="vsm-tk-monto">Monto a descontar</label>
            <input type="number" id="vsm-tk-monto" class="vsm-input" min="0.01" step="0.01">
          </div>
          <div class="vsm-filtro-grupo vsm-filtro-grupo--ancho">
            <label for="vsm-tk-motivo">Motivo</label>
            <input type="text" id="vsm-tk-motivo" class="vsm-input" placeholder="Ej: Error de impresión, tóner mal configurado" maxlength="300">
          </div>
          <button class="vsm-btn-agregar" id="vsm-tk-btn-aplicar" onclick="window.vsmAplicarAjuste()">
            <i class="ti ti-check"></i> Aplicar descuento
          </button>
        </div>

        <div id="vsm-tk-previos" class="vsm-tk-previos"></div>
      </div>
    </div>

  </div>
</div>

{{/if}}
