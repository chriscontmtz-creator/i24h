    <!-- Topbar -->
    <div class="panel-topbar">
      <!-- Botón hamburguesa (solo visible en móvil) -->
      <button class="nav-hamburger panel-hamburger" id="panel-hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="panel-sidebar">
        <i class="ti ti-menu-2" id="panel-hamburger-ico" aria-hidden="true"></i>
      </button>

      <h1 class="panel-topbar-titulo" id="panel-titulo">{{#if esColaborador}}Bitácoras{{else}}Dashboard{{/if}}</h1>

      <div class="panel-topbar-centro">
        <span class="panel-suc-pill">
          <i class="ti ti-building-store"></i> Todas las sucursales
        </span>
      </div>

      <div class="panel-topbar-acciones">
        <button class="toggle-btn" id="toggle-btn-panel" aria-label="Cambiar modo">
          <i class="ti ti-moon" id="tico-panel"></i>
          <span id="tlbl-panel">Modo oscuro</span>
        </button>
        <button class="panel-notif-btn" aria-label="Notificaciones">
          <i class="ti ti-bell"></i>
          <span class="panel-notif-dot"></span>
        </button>
      </div>
    </div>

    <!-- Zona de contenido con scroll -->
    <div class="panel-content">


      <!-- ======================================================
           DASHBOARD (por defecto)
           ====================================================== -->
      <div class="panel-seccion{{#if esColaborador}} oculta{{/if}}" id="sec-dashboard">

        <!-- ── Fila 1: 4 KPIs ──────────────────────────────── -->
        <div class="panel-metrics">
          <div class="panel-metric-card dash-clickable" onclick="irSeccion('ventas','Ventas')">
            <span class="panel-metric-label"><i class="ti ti-cash" style="font-size:.85rem"></i> Ventas 7 días</span>
            <span class="panel-metric-valor" id="dash-vnt-total">—</span>
            <span class="panel-metric-sub" id="dash-vnt-sub">Cargando…</span>
          </div>
          <div class="panel-metric-card dash-clickable" onclick="irSeccion('inventario','Inventario / Stock')">
            <span class="panel-metric-label"><i class="ti ti-alert-triangle" style="font-size:.85rem"></i> Alertas de stock</span>
            <span class="panel-metric-valor" id="dash-stk-cnt" style="color:#dc2626">—</span>
            <span class="panel-metric-sub" id="dash-stk-sub">Cargando…</span>
          </div>
          <div class="panel-metric-card">
            <span class="panel-metric-label"><i class="ti ti-users" style="font-size:.85rem"></i> Empleados activos</span>
            <span class="panel-metric-valor" id="dash-cnt-emp">—</span>
            <span class="panel-metric-sub" id="dash-sub-emp">Cargando…</span>
          </div>
          <div class="panel-metric-card">
            <span class="panel-metric-label"><i class="ti ti-id-badge" style="font-size:.85rem"></i> Clientes</span>
            <span class="panel-metric-valor" id="dash-cnt-cli">—</span>
            <span class="panel-metric-sub" id="dash-sub-cli">Cargando…</span>
          </div>
        </div>

        <!-- ── Fila 2: ventas categorías | alertas stock | reportes ── -->
        <div class="dash-grid-3">

          <!-- Ventas por categoría -->
          <div class="panel-card">
            <div class="dash-card-hdr">
              <p class="panel-card-titulo">Ventas por categoría</p>
              <span class="dash-period-badge">7 días</span>
            </div>
            <div id="dash-cat-wrap">
              <div class="dash-empty"><i class="ti ti-loader-2"></i>Cargando…</div>
            </div>
            <p class="panel-card-footer" id="dash-vnt-footer">Top sucursal: —</p>
          </div>

          <!-- Alertas de stock -->
          <div class="panel-card">
            <div class="dash-card-hdr">
              <p class="panel-card-titulo">Alertas de stock</p>
              <button class="dash-link-btn" onclick="irSeccion('inventario','Inventario / Stock')">Ver todo</button>
            </div>
            <div id="dash-alertas-wrap">
              <div class="dash-empty"><i class="ti ti-loader-2"></i>Cargando…</div>
            </div>
          </div>

          <!-- Reportes recientes -->
