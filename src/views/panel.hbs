            <div class="dash-card-hdr">
              <p class="panel-card-titulo">Reportes recientes</p>
              <button class="dash-link-btn" onclick="irSeccion('reportes','Reportes depto.')">Ver todos</button>
            </div>
            <div id="dash-rpt-wrap">
              <div class="dash-empty"><i class="ti ti-loader-2"></i>Cargando…</div>
            </div>
          </div>

        </div>

