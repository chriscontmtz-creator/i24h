<script>document.body.style.overflow='hidden';</script>

<div class="panel-root">

  <!-- ============================================================
       SIDEBAR
       ============================================================ -->
  <aside class="panel-sidebar" id="panel-sidebar">

    <!-- Logo -->
    <div class="panel-sidebar-logo">
      <span class="panel-logo-text">i24h</span>
      <span class="panel-logo-suc">Sucursal: Todas</span>
    </div>

    <!-- Menú de navegación -->
    <nav class="panel-nav-menu">

      {{#unless esColaborador}}
      <!-- PRINCIPAL -->
      <div class="panel-nav-grupo">
        <span class="panel-nav-label">Principal</span>
        <a href="/dashboard" class="panel-nav-item" style="text-decoration:none">
          <i class="ti ti-layout-dashboard"></i><span>Dashboard</span>
        </a>
        <button class="panel-nav-item active" data-seccion="dashboard" data-titulo="Panel">
          <i class="ti ti-grid-dots"></i><span>Panel</span>
        </button>
        <button class="panel-nav-item" data-seccion="sucursales" data-titulo="Sucursales">
          <i class="ti ti-building-store"></i><span>Sucursales</span>
        </button>
        <button class="panel-nav-item" data-seccion="ventas" data-titulo="Ventas">
          <i class="ti ti-cash-register"></i><span>Ventas</span>
        </button>
      </div>
      {{/unless}}

      <!-- OPERACIONES -->
      <div class="panel-nav-grupo">
        <span class="panel-nav-label">Operaciones</span>
        {{#unless esColaborador}}
        <a href="/revisiones" class="panel-nav-item" style="text-decoration:none">
          <i class="ti ti-clipboard-check"></i><span>Revisiones</span>
        </a>
        {{/unless}}
        <button class="panel-nav-item{{#if esColaborador}} active{{/if}}" data-seccion="bitacoras" data-titulo="Bitácoras">
          <i class="ti ti-notebook"></i><span>Bitácoras</span>
        </button>
        <button class="panel-nav-item" data-seccion="asistencia" data-titulo="Asistencia">
          <i class="ti ti-qrcode"></i><span>Asistencia</span>
        </button>
        {{#unless esColaborador}}
        <button class="panel-nav-item" data-seccion="inventario" data-titulo="Inventario / Stock">
          <i class="ti ti-package"></i><span>Inventario / Stock</span>
        </button>
        <button class="panel-nav-item" data-seccion="reportes" data-titulo="Reportes depto.">
          <i class="ti ti-clipboard-list"></i><span>Reportes depto.</span>
          <span class="panel-badge">0</span>
        </button>
        {{/unless}}
      </div>

      {{#unless esColaborador}}
      <!-- EQUIPO -->
      <div class="panel-nav-grupo">
        <span class="panel-nav-label">Equipo</span>
        <a href="/empleados.html" class="panel-nav-item" style="text-decoration:none">
          <i class="ti ti-users"></i><span>Empleados</span>
        </a>
        <a href="/horarios" class="panel-nav-item" style="text-decoration:none">
          <i class="ti ti-calendar-time"></i><span>Horarios</span>
        </a>
      </div>
      {{/unless}}

      <!-- SISTEMA (solo admins) -->
      {{#if esAdmin}}
      <div class="panel-nav-grupo">
        <span class="panel-nav-label">Sistema</span>
        <button class="panel-nav-action" onclick="window.abrirModalMaterial()">
          <i class="ti ti-pencil-dollar"></i><span>Venta sin material y sin tickets</span>
        </button>
        <button class="panel-nav-item" data-seccion="usuarios" data-titulo="Usuarios">
          <i class="ti ti-user-cog"></i><span>Usuarios</span>
        </button>
        <button class="panel-nav-item" data-seccion="promociones" data-titulo="Promociones">
          <i class="ti ti-speakerphone"></i><span>Promociones</span>
        </button>
        <button class="panel-nav-item" data-seccion="fotos-sucursal" data-titulo="Fotos de sucursal">
          <i class="ti ti-photo"></i><span>Fotos de sucursal</span>
        </button>
        <button class="panel-nav-item" data-seccion="configuracion" data-titulo="Configuración">
          <i class="ti ti-settings"></i><span>Configuración</span>
        </button>
      </div>
      {{/if}}

    </nav>

    <!-- Botón regresar al inicio -->
    <div class="panel-sidebar-inicio">
      <a href="/" class="panel-nav-inicio">
        <i class="ti ti-home"></i><span>Página principal</span>
      </a>
    </div>

    <script>window.BIT_USUARIO = '{{usuario.nombre}}';</script>

    <!-- Tarjeta del usuario -->
    <div class="panel-sidebar-usuario" onclick="perfilAbrirModal()" title="Editar mi perfil" style="cursor:pointer">
      <div class="panel-sidebar-avatar">{{usuario.nombre.[0]}}</div>
      <div class="panel-sidebar-info">
        <p class="panel-sidebar-nombre">{{usuario.nombre}}</p>
        <p class="panel-sidebar-cargo">{{usuario.cargo}} · Todas</p>
      </div>
      <i class="ti ti-pencil" style="font-size:13px;color:var(--texto-suave);flex-shrink:0;margin-left:auto"></i>
    </div>

    <button class="panel-nav-action" id="panel-btn-logout" style="margin:2px 8px 8px">
      <i class="ti ti-logout"></i> Cerrar sesión
    </button>

  </aside>

  <!-- Fondo oscuro detrás del sidebar cuando está abierto en móvil -->
  <div class="panel-sidebar-fondo" id="panel-sidebar-fondo"></div>


