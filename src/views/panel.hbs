            '<input class="usr-field-inp" type="password" id="usr-em-pass" placeholder="M\xEDn. 6 caracteres">' +
            '<label class="usr-field-lbl">Confirmar contrase\xF1a</label>' +
            '<input class="usr-field-inp" type="password" id="usr-em-pass2" placeholder="Repetir">',
      accion: async function() {
        var p  = document.getElementById('usr-em-pass').value;
        var p2 = document.getElementById('usr-em-pass2').value;
        if(p.length < 6) { alert('La contrase\xF1a debe tener al menos 6 caracteres.'); return; }
        if(p !== p2)      { alert('Las contrase\xF1as no coinciden.'); return; }
        var res = await fetch('/api/empleados/' + id + '/password', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: p })
        });
        if(!res.ok) { var e = await res.json(); alert(e.error || 'Error al cambiar contrase\xF1a'); return; }
        usrCerrarEM();
        alert('Contrase\xF1a cambiada correctamente.');
      }
    });
  }
  window.usrCambiarPassword = usrCambiarPassword;

  // ── acción: ajustar puntos ──────────────────────────────────────────────
  function usrAjustarPuntos(id, correo, ptsActuales) {
    usrCerrarMenu();
    usrAbrirEM({
      icono: 'ti-star',
      titulo: 'Ajustar puntos',
      sub: correo,
      html: '<p class="usr-pts-actual">Puntos actuales: <strong>' + (ptsActuales||0) + ' pts</strong></p>' +
        '<div class="usr-pts-row">' +
          '<button class="usr-pts-btn" onclick="var i=document.getElementById(\'usr-em-pts\');i.value=Math.max(-9999,Number(i.value)-10)">&#8722;10</button>' +
          '<button class="usr-pts-btn" onclick="var i=document.getElementById(\'usr-em-pts\');i.value=Math.max(-9999,Number(i.value)-1)">&#8722;</button>' +
          '<input class="usr-pts-inp" type="number" id="usr-em-pts" value="0">' +
          '<button class="usr-pts-btn" onclick="var i=document.getElementById(\'usr-em-pts\');i.value=Number(i.value)+1">+</button>' +
          '<button class="usr-pts-btn" onclick="var i=document.getElementById(\'usr-em-pts\');i.value=Number(i.value)+10">+10</button>' +
        '</div>' +
        '<label class="usr-field-lbl">Motivo del ajuste</label>' +
        '<input class="usr-field-inp" type="text" id="usr-em-motivo" placeholder="Ej: Correcci\xF3n de puntos">',
      guardarLabel: 'Aplicar ajuste',
      accion: async function() {
        var ajuste = Number(document.getElementById('usr-em-pts').value);
        var motivo = document.getElementById('usr-em-motivo').value.trim();
        if(!ajuste) { alert('Ingresa un valor distinto de 0.'); return; }
        if(!motivo) { alert('El motivo es obligatorio.'); return; }
        var res = await fetch('/api/clientes/' + id + '/puntos', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ajuste: ajuste, motivo: motivo })
        });
        if(!res.ok) { var e = await res.json(); alert(e.error || 'Error al ajustar puntos'); return; }
        var datos = await res.json();
        usrCerrarEM();
        await usrCargarTodo();
        alert('Puntos actualizados. Nuevo total: ' + datos.puntos + ' pts');
      }
    });
  }
  window.usrAjustarPuntos = usrAjustarPuntos;

  // ── acción: ver canjes ──────────────────────────────────────────────────
  async function usrVerCanjes(id, correo) {
    usrCerrarMenu();
    var res   = await fetch('/api/clientes/' + id + '/canjes');
    var datos = await res.json();
    var canjes = datos.canjes || [];
    var html = canjes.length === 0
      ? '<div class="usr-empty">Este cliente no ha realizado canjes todav\xEDa.</div>'
      : canjes.map(function(cj) {
          var f = cj.fecha ? new Date(cj.fecha).toLocaleDateString('es-MX') : '—';
          return '<div class="usr-canje-item">' +
            '<div class="usr-canje-ico"><i class="ti ti-gift" aria-hidden="true"></i></div>' +
            '<div><div class="usr-canje-nombre">' + (cj.recompensa||'—') + '</div>' +
            '<div class="usr-canje-meta">' + f + '</div></div>' +
            '<div class="usr-canje-pts">&#8722;' + (cj.puntosUsados||0) + ' pts</div>' +
          '</div>';
        }).join('');
    usrAbrirEM({
      icono: 'ti-gift',
      titulo: 'Historial de canjes',
      sub: correo + ' \xB7 ' + canjes.length + ' canje' + (canjes.length === 1 ? '' : 's'),
      html: html,
      readonly: true
    });
  }
  window.usrVerCanjes = usrVerCanjes;

  // ── acción: ver QR ──────────────────────────────────────────────────────
  function usrVerQR(id, correo, qrId) {
    usrCerrarMenu();
    var dato   = qrId || id;
    var imgUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(dato);
    usrAbrirEM({
      icono: 'ti-qrcode',
      titulo: 'C\xF3digo QR',
      sub: correo,
      html: '<div class="usr-qr-wrap">' +
        '<img class="usr-qr-img" src="' + imgUrl + '" alt="QR" width="220" height="220">' +
        '<div class="usr-qr-id">' + dato + '</div>' +
        '<button class="usr-qr-copy" onclick="navigator.clipboard.writeText(\'' + dato.replace(/'/g,"\\'") + '\').then(function(){this.innerHTML=\'<i class=\\\'ti ti-check\\\'></i> \xA1Copiado!\';}.bind(this))">' +
          '<i class="ti ti-copy" aria-hidden="true"></i> Copiar ID' +
        '</button>' +
      '</div>',
      readonly: true
    });
  }
  window.usrVerQR = usrVerQR;

  // ── selector de cantidad de códigos ────────────────────────────────────
  var usrCodQty = 1;
  document.querySelectorAll('#usr-cod-qty .usr-cod-qty-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      usrCodQty = Number(btn.dataset.qty);
      document.querySelectorAll('#usr-cod-qty .usr-cod-qty-btn').forEach(function(b) {
        b.classList.toggle('activo', b === btn);
      });
    });
  });

  // ── event listeners principales ─────────────────────────────────────────
  var btnNuevo   = document.getElementById('usr-btn-nuevo-emp');
  var btnGuardar = document.getElementById('usr-btn-guardar-emp');
  var btnGenCod  = document.getElementById('usr-btn-gen-cod');

  if(btnNuevo)  btnNuevo.addEventListener('click', usrAbrirDrawer);

  if(btnGuardar) btnGuardar.addEventListener('click', async function() {
    var nombre     = document.getElementById('usr-reg-nombre').value.trim();
    var correo     = document.getElementById('usr-reg-correo').value.trim();
    var cargo      = document.getElementById('usr-reg-cargo').value;
    var pass       = document.getElementById('usr-reg-pass').value;
    var pass2      = document.getElementById('usr-reg-pass2').value;
    var msg        = document.getElementById('usr-reg-msg');
    var sucursales = Array.from(document.querySelectorAll('#usr-reg-suc-wrap input:checked')).map(function(cb){ return cb.value; });

    var mostrarMsg = function(txt, tipo) {
      msg.textContent = txt;
      msg.style.display = '';
      var oscuro = document.body.classList.contains('dark');
      msg.style.background = tipo === 'error' ? (oscuro ? '#450a0a' : '#fee2e2') : (oscuro ? '#052e16' : '#dcfce7');
      msg.style.color      = tipo === 'error' ? (oscuro ? '#fca5a5' : '#991b1b') : (oscuro ? '#4ade80' : '#166534');
    };

    if(!nombre||!correo||!pass) return mostrarMsg('Completa todos los campos obligatorios.','error');
    if(pass.length < 6)         return mostrarMsg('La contrase\xF1a debe tener al menos 6 caracteres.','error');
    if(pass !== pass2)          return mostrarMsg('Las contrase\xF1as no coinciden.','error');

    try {
      var res = await fetch('/api/empleados', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ correo: correo, password: pass, nombre: nombre, cargo: cargo, sucursales: sucursales })
      });
      var datos = await res.json();
      if(!res.ok) return mostrarMsg(datos.error || 'Error al crear la cuenta.','error');
      mostrarMsg('\xA1Cuenta creada correctamente!','ok');
      setTimeout(function() {
        usrCerrarDrawer();
        msg.style.display = 'none';
        document.getElementById('usr-reg-nombre').value = '';
        document.getElementById('usr-reg-correo').value = '';
        document.getElementById('usr-reg-pass').value   = '';
        document.getElementById('usr-reg-pass2').value  = '';
        document.querySelectorAll('#usr-reg-suc-wrap input').forEach(function(cb){ cb.checked = false; });
      }, 1500);
      await usrCargarTodo();
    } catch(e) { mostrarMsg('Error de conexi\xF3n con el servidor.','error'); }
  });

  if(btnGenCod) btnGenCod.addEventListener('click', async function() {
    try {
      var generados = [];
      for(var i = 0; i < usrCodQty; i++) {
        var res = await fetch('/api/codigos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ creadoPor: 'admin' })
        });
        var datos = await res.json();
        if(!res.ok) { alert('Error al generar el c\xF3digo.'); return; }
        generados.push(datos.codigo);
      }
      alert('C\xF3digo' + (generados.length > 1 ? 's generados:' : ' generado:') + '\n\n' + generados.join('\n') + '\n\nEntr\xE9galos al cliente en sucursal. Son de un solo uso.');
      await usrCargarTodo();
    } catch(e) { alert('Error de conexi\xF3n.'); }
  });

  usrCargarTodo();
})();


// ============================================================
//  PROMOCIONES — CRUD desde el panel (solo admin/coordinador)
// ============================================================
(function () {
  var promoLista = [];

  function promoFmtFecha(f) {
    return new Date(f).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function promoEstado(p) {
    var ahora = new Date();
    var ini   = new Date(p.fechaInicio);
    var fin   = new Date(p.fechaFin);
    if (!p.activa) return { txt: 'Inactiva', cls: 'promo-badge-inactiva' };
    if (ahora < ini) return { txt: 'Próxima', cls: 'promo-badge-proxima' };
    if (ahora > fin) return { txt: 'Vencida', cls: 'promo-badge-vencida' };
    return { txt: 'Vigente', cls: 'promo-badge-vigente' };
  }

  function promoRender() {
    var cont = document.getElementById('promo-grid');
    if (!cont) return;
    if (!promoLista.length) {
      cont.innerHTML = '<div class="usr-empty">Aún no hay promociones. Crea la primera con el botón de arriba.</div>';
      return;
    }
    cont.innerHTML = promoLista.map(function (p) {
      var estado = promoEstado(p);
      return '<div class="promo-card">' +
        (p.imagenUrl ? '<img class="promo-card-img" src="' + escHtml(p.imagenUrl) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">' : '') +
        '<div class="promo-card-body">' +
          '<div class="promo-card-hdr">' +
            '<p class="promo-card-titulo">' + escHtml(p.titulo) + '</p>' +
            '<span class="promo-badge ' + estado.cls + '">' + estado.txt + '</span>' +
          '</div>' +
          '<p class="promo-card-desc">' + escHtml(p.descripcion) + '</p>' +
          (p.beneficio ? '<span class="promo-card-beneficio"><i class="ti ti-gift"></i> ' + escHtml(p.beneficio) + '</span>' : '') +
          '<p class="promo-card-vigencia"><i class="ti ti-calendar"></i> ' + promoFmtFecha(p.fechaInicio) + ' — ' + promoFmtFecha(p.fechaFin) + '</p>' +
          '<div class="promo-card-acciones">' +
            '<button class="btn-o btn-sm" onclick="promoEditar(\'' + escJs(p._id) + '\')"><i class="ti ti-edit"></i> Editar</button>' +
            '<button class="btn-o btn-sm" onclick="promoEliminar(\'' + escJs(p._id) + '\')"><i class="ti ti-trash"></i> Eliminar</button>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  async function promoCargar() {
    try {
      var res  = await fetch('/api/promociones');
      promoLista = await res.json();
      promoRender();
    } catch (e) {
      var cont = document.getElementById('promo-grid');
      if (cont) cont.innerHTML = '<div class="usr-empty">Error al cargar promociones.</div>';
    }
  }

  function promoFormHtml(p) {
    p = p || {};
    var toInputDate = function (f) { return f ? new Date(f).toISOString().slice(0, 10) : ''; };
    return '<label class="usr-field-lbl">Título</label>' +
      '<input class="usr-field-inp" type="text" id="promo-em-titulo" value="' + (p.titulo || '').replace(/"/g, '&quot;') + '" placeholder="Ej: 2x1 en impresiones">' +
      '<label class="usr-field-lbl">Descripción</label>' +
      '<textarea class="usr-field-inp" id="promo-em-desc" rows="3" placeholder="Detalles de la promoción">' + (p.descripcion || '') + '</textarea>' +
      '<label class="usr-field-lbl">Imagen (URL, opcional)</label>' +
      '<input class="usr-field-inp" type="text" id="promo-em-img" value="' + (p.imagenUrl || '').replace(/"/g, '&quot;') + '" placeholder="https://...">' +
      '<label class="usr-field-lbl">Beneficio (opcional)</label>' +
      '<input class="usr-field-inp" type="text" id="promo-em-beneficio" value="' + (p.beneficio || '').replace(/"/g, '&quot;') + '" placeholder="Ej: 20% de descuento">' +
      '<label class="usr-field-lbl">Vigencia</label>' +
      '<div class="usr-pts-row" style="gap:8px">' +
        '<input class="usr-field-inp" type="date" id="promo-em-inicio" value="' + toInputDate(p.fechaInicio) + '">' +
        '<input class="usr-field-inp" type="date" id="promo-em-fin" value="' + toInputDate(p.fechaFin) + '">' +
      '</div>' +
      '<label class="usr-field-lbl" style="display:flex;align-items:center;gap:8px;margin-top:10px">' +
        '<input type="checkbox" id="promo-em-activa"' + (p.activa === false ? '' : ' checked') + '> Activa' +
      '</label>';
  }

  function promoLeerForm() {
    return {
      titulo:      document.getElementById('promo-em-titulo').value.trim(),
      descripcion: document.getElementById('promo-em-desc').value.trim(),
      imagenUrl:   document.getElementById('promo-em-img').value.trim(),
      beneficio:   document.getElementById('promo-em-beneficio').value.trim(),
      fechaInicio: document.getElementById('promo-em-inicio').value,
      fechaFin:    document.getElementById('promo-em-fin').value,
      activa:      document.getElementById('promo-em-activa').checked,
    };
  }

  function promoAbrirNueva() {
    window.usrAbrirEM({
      icono: 'ti-speakerphone',
      titulo: 'Nueva promoción',
      sub: 'Se muestra en el panel del cliente mientras esté vigente',
      html: promoFormHtml(),
      guardarLabel: 'Crear promoción',
      accion: async function () {
        var datos = promoLeerForm();
        if (!datos.titulo || !datos.descripcion || !datos.fechaInicio || !datos.fechaFin) {
          alert('Completa título, descripción y vigencia.'); return;
        }
        var res  = await fetch('/api/promociones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        });
        if (!res.ok) { var e = await res.json(); alert(e.error || 'Error al crear la promoción.'); return; }
        window.usrCerrarEM();
        await promoCargar();
      },
    });
  }

  window.promoEditar = function (id) {
    var p = promoLista.find(function (x) { return x._id === id; });
    if (!p) return;
    window.usrAbrirEM({
      icono: 'ti-speakerphone',
      titulo: 'Editar promoción',
      sub: p.titulo,
      html: promoFormHtml(p),
      guardarLabel: 'Guardar cambios',
      accion: async function () {
        var datos = promoLeerForm();
        if (!datos.titulo || !datos.descripcion || !datos.fechaInicio || !datos.fechaFin) {
          alert('Completa título, descripción y vigencia.'); return;
        }
        var res  = await fetch('/api/promociones/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        });
        if (!res.ok) { var e = await res.json(); alert(e.error || 'Error al guardar los cambios.'); return; }
        window.usrCerrarEM();
        await promoCargar();
      },
    });
  };

  window.promoEliminar = async function (id) {
    if (!confirm('¿Eliminar esta promoción? No se puede deshacer.')) return;
    var res = await fetch('/api/promociones/' + id, { method: 'DELETE' });
    if (!res.ok) { var e = await res.json(); alert(e.error || 'Error al eliminar.'); return; }
    await promoCargar();
  };

  var btnNueva = document.getElementById('promo-btn-nueva');
  if (btnNueva) btnNueva.addEventListener('click', promoAbrirNueva);

  document.querySelector('[data-seccion="promociones"]')?.addEventListener('click', promoCargar);
})();


// ============================================================
//  FOTOS DE SUCURSAL — subida real de archivos (solo admin/coordinador)
// ============================================================
(function () {
  var fotoLista = [];

  function fotoRender() {
    var cont = document.getElementById('foto-grid');
    if (!cont) return;
    if (!fotoLista.length) {
      cont.innerHTML = '<div class="usr-empty">Esta sucursal todavía no tiene fotos.</div>';
      return;
    }
    cont.innerHTML = fotoLista.map(function (f) {
      return '<div class="promo-card">' +
        '<img class="promo-card-img" src="/imagenes/sucursales/' + f.archivo + '" alt="" loading="lazy">' +
        '<div class="promo-card-body">' +
          '<button class="btn-o btn-sm" onclick="fotoEliminar(\'' + f._id + '\')" style="width:100%"><i class="ti ti-trash"></i> Eliminar</button>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  async function fotoCargar() {
    var sel = document.getElementById('foto-sel-suc');
    var cont = document.getElementById('foto-grid');
    try {
      var res  = await fetch('/api/fotos-sucursal?sucursal=' + encodeURIComponent(sel.value));
      fotoLista = await res.json();
      fotoRender();
    } catch (e) {
      if (cont) cont.innerHTML = '<div class="usr-empty">Error al cargar las fotos.</div>';
    }
  }

  window.fotoEliminar = async function (id) {
    if (!confirm('¿Eliminar esta foto? No se puede deshacer.')) return;
    var res = await fetch('/api/fotos-sucursal/' + id, { method: 'DELETE' });
    if (!res.ok) { var e = await res.json(); alert(e.error || 'Error al eliminar.'); return; }
    await fotoCargar();
  };

  var selSuc   = document.getElementById('foto-sel-suc');
  var btnSubir = document.getElementById('foto-btn-subir');
  var inpArch  = document.getElementById('foto-input-archivo');
  var msgSub   = document.getElementById('foto-subiendo-msg');

  if (selSuc) selSuc.addEventListener('change', fotoCargar);
  if (btnSubir) btnSubir.addEventListener('click', function () { inpArch.click(); });

  if (inpArch) inpArch.addEventListener('change', async function () {
    var archivo = inpArch.files[0];
    if (!archivo) return;

    var datos = new FormData();
    datos.append('sucursal', selSuc.value);
    datos.append('foto', archivo);

    btnSubir.disabled = true;
    if (msgSub) msgSub.style.display = 'inline';
    try {
      var res = await fetch('/api/fotos-sucursal', { method: 'POST', body: datos });
      if (!res.ok) { var e = await res.json(); alert(e.error || 'Error al subir la foto.'); }
      else { await fotoCargar(); }
    } catch (e) {
      alert('Error de conexión al subir la foto.');
    } finally {
      btnSubir.disabled = false;
      if (msgSub) msgSub.style.display = 'none';
      inpArch.value = '';
    }
  });

  document.querySelector('[data-seccion="fotos-sucursal"]')?.addEventListener('click', fotoCargar);
})();


// ============================================================
//  REPORTES DEPARTAMENTO
// ============================================================
(function () {
  var rptActiveDept   = 'all';
  var rptActiveSuc    = 'all';
  var rptActiveStatus = 'all';

  var rptDepts = { imp: 'Impresoras', mant: 'Mantenimiento', sis: 'Sistemas', bodega: 'Bodega' };
  var rptDias  = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
  var rptMeses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

  function rptPad(n) { return n.toString().padStart(2, '0'); }

  function rptGetNow() {
    var n = new Date();
    return {
      dia:   rptDias[n.getDay()],
      fecha: rptPad(n.getDate()) + '/' + rptPad(n.getMonth() + 1) + '/' + n.getFullYear(),
      hora:  rptPad(n.getHours()) + ':' + rptPad(n.getMinutes()),
      d:     rptPad(n.getDate()),
      mes:   rptMeses[n.getMonth()],
      y:     n.getFullYear()
    };
  }

  function rptTick() {
    var t  = rptGetNow();
    var e1 = document.getElementById('rpt-livetime');
    var e2 = document.getElementById('rpt-cardtime');
    if (e1) e1.textContent = t.dia + ', ' + t.d + ' ' + t.mes + ' ' + t.y + ' · ' + t.hora;
    if (e2) e2.textContent = t.fecha + ' · ' + t.hora;
  }

  rptTick();
  setInterval(rptTick, 30000);

  window.rptSelectDept = function (dept) {
    ['imp', 'mant', 'sis', 'bodega'].forEach(function (d) {
      var btn = document.getElementById('rpt-d-' + d);
      if (btn) btn.className = 'rpt-dept-btn';
    });
    var active = document.getElementById('rpt-d-' + dept);
    if (active) active.classList.add('active-' + dept);
    var extra = document.getElementById('rpt-extraFields');
    if (extra) extra.style.display = dept === 'imp' ? 'flex' : 'none';
  };

  function rptApplyFilters() {
    document.querySelectorAll('.rpt-card').forEach(function (c) {
      var dOk  = rptActiveDept   === 'all' || c.dataset.dept   === rptActiveDept;
      var sOk  = rptActiveSuc    === 'all' || c.dataset.suc    === rptActiveSuc;
      var stOk = rptActiveStatus === 'all' || c.dataset.status === rptActiveStatus;
      c.classList.toggle('hidden', !(dOk && sOk && stOk));
    });
  }

  window.rptFilterDept = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add(val === 'all' ? 'active-all' : 'active-' + val);
    rptActiveDept = val;
    rptApplyFilters();
  };

  window.rptFilterSuc = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add('active-suc');
    rptActiveSuc = val;
    rptApplyFilters();
  };

  window.rptFilterStatus = function (btn, val) {
    btn.closest('.rpt-filter-row').querySelectorAll('.rpt-pill').forEach(function (p) { p.className = 'rpt-pill'; });
    btn.classList.add(val === 'all' ? 'active-all' : val === 'pendiente' ? 'active-pend' : 'active-done');
    rptActiveStatus = val;
    rptApplyFilters();
  };

  window.rptToggleStatus = function (btn) {
    var card   = btn.closest('.rpt-card');
    var isPend = card.dataset.status === 'pendiente';
    var nuevoStatus = isPend ? 'realizado' : 'pendiente';
    card.dataset.status = nuevoStatus;
    card.classList.toggle('done', !isPend);
    btn.className = 'rpt-status-toggle ' + nuevoStatus;
    btn.innerHTML = isPend
      ? '<i class="ti ti-check" style="font-size:11px" aria-hidden="true"></i> Realizado'
      : '<i class="ti ti-clock" style="font-size:11px" aria-hidden="true"></i> Pendiente';
    rptApplyFilters();
    // Persistir en la API si el card tiene id guardado
    var rptId = card.dataset.rptId;
    if (rptId) {
      fetch('/api/reportes/' + rptId + '/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nuevoStatus }),
      }).catch(function () {});
    }
  };

  window.rptCrearReporte = function () {
    var suc   = document.getElementById('rpt-sel-suc').value;
    var desc  = document.getElementById('rpt-inp-desc').value.trim();
    var t     = rptGetNow();
    var active = document.querySelector('[id^="rpt-d-"][class*="active"]');
    var dept  = active ? active.id.replace('rpt-d-', '') : 'imp';

    var lines = [suc, t.fecha, t.dia, '', 'REPORTE', '', rptDepts[dept], ''];
    if (dept === 'imp') {
      var marca = document.getElementById('rpt-inp-marca').value.trim();
      var num   = document.getElementById('rpt-inp-num').value.trim();
      if (marca) lines.push(marca);
      if (num)   { lines.push(''); lines.push('No. Impresora'); lines.push(num); }
      lines.push('');
    }
    lines.push(desc || 'Sin descripción.');
    lines.push('');
    lines.push('@Monitoreo');

    // Insertar tarjeta al inicio del feed
    var feed = document.getElementById('rpt-feed');
    var card = document.createElement('div');
    card.className        = 'rpt-card ' + dept;
    card.dataset.dept     = dept;
    card.dataset.suc      = suc;
    card.dataset.status   = 'pendiente';

    var numVal  = dept === 'imp' ? document.getElementById('rpt-inp-num').value.trim() : '';
    var impChip = numVal ? '<span class="rpt-printer-chip">' + numVal + '</span>' : '';

    card.innerHTML =
      '<div class="rpt-card-top">' +
        '<div class="rpt-card-meta">' +
          '<span class="rpt-dept-tag ' + dept + '">' + rptDepts[dept] + '</span>' +
          '<span class="rpt-suc-name">' + suc + '</span>' +
          '<span class="rpt-new-badge">nuevo</span>' +
        '</div>' +
        '<div class="rpt-card-right">' +
          '<span class="rpt-card-time">Ahora · ' + t.hora + '</span>' +
          '<button class="rpt-status-toggle pendiente" onclick="rptToggleStatus(this)" aria-label="Cambiar estado">' +
            '<i class="ti ti-clock" style="font-size:11px" aria-hidden="true"></i> Pendiente' +
          '</button>' +
        '</div>' +
      '</div>' +
      '<p class="rpt-card-desc">' + (desc || 'Sin descripción.') + '</p>' +
      '<div class="rpt-card-footer"><span class="rpt-mention">@Monitoreo</span>' + impChip + '</div>';

    feed.insertBefore(card, feed.firstChild);

    // Actualizar badge del menú
    var badge = document.querySelector('[data-seccion="reportes"] .panel-badge');
    if (badge) badge.textContent = parseInt(badge.textContent || '0') + 1;

    // Mostrar modal
    document.getElementById('rpt-msg-text').textContent = lines.join('\n');
    document.getElementById('rpt-overlay').classList.add('open');
    document.getElementById('rpt-copy-label').textContent = 'Copiar mensaje';
    document.getElementById('rpt-copy-icon').className    = 'ti ti-copy';

    // Limpiar formulario
    document.getElementById('rpt-inp-desc').value  = '';
    document.getElementById('rpt-inp-num').value   = '';
    document.getElementById('rpt-inp-marca').value = '';

    rptApplyFilters();

    // Persistir en la API (guarda en datos/reportes.json)
    var payload = {
      sucursal:    suc,
      dept:        dept,
      descripcion: desc || 'Sin descripción.',
      numImpresora: dept === 'imp' ? numVal : '',
      marca:        dept === 'imp' ? document.getElementById('rpt-inp-marca')?.value.trim() || '' : '',
      mensaje:      lines.join('\n'),
    };
    fetch('/api/reportes', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    }).then(function (r) { return r.json(); })
      .then(function (saved) {
        if (saved.id) card.dataset.rptId = saved.id;
      }).catch(function () {});
  };

  window.rptCopiarMensaje = function () {
    var txt = document.getElementById('rpt-msg-text').textContent;
    navigator.clipboard.writeText(txt).then(function () {
      document.getElementById('rpt-copy-label').textContent = '¡Copiado!';
      document.getElementById('rpt-copy-icon').className    = 'ti ti-check';
      setTimeout(function () {
        document.getElementById('rpt-copy-label').textContent = 'Copiar mensaje';
        document.getElementById('rpt-copy-icon').className    = 'ti ti-copy';
      }, 2500);
    }).catch(function () {
      document.getElementById('rpt-copy-label').textContent = 'Copia el texto arriba';
    });
  };

  window.rptCloseModal = function (e) {
    if (!e || e.target === document.getElementById('rpt-overlay')) {
      document.getElementById('rpt-overlay').classList.remove('open');
    }
  };

  // Cerrar modal con Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var overlay = document.getElementById('rpt-overlay');
      if (overlay && overlay.classList.contains('open')) overlay.classList.remove('open');
    }
  });
})();

// =============================================================
//  SECCIÓN VENTAS — lógica completa
// =============================================================
(function () {

  // Colores fijos de categoría
  var CAT_COLOR = { Novedades: '#7F77DD', Papelería: '#1D9E75', Snack: '#D85A30' };

  // Badge de sucursal: fondo y texto
  var SUC_BADGE = {
    'simon-bolivar': { bg: '#dbeafe', color: '#1e40af', label: 'S.Bolívar' },
    'insurgentes':   { bg: '#ede9fe', color: '#5b21b6', label: 'Insurgentes' },
    'antigona':      { bg: '#d1fae5', color: '#065f46', label: 'Antígona'  },
    'lincoln-oxxo':  { bg: '#fef3c7', color: '#92400e', label: 'L.Oxxo'    },
    'lincoln-2':     { bg: '#ffedd5', color: '#7c2d12', label: 'Lincoln 2'  },
    'ruiz-cortines': { bg: '#dbeafe', color: '#1e3a5f', label: 'R.Cortines' },
    'rodas':         { bg: '#ede9fe', color: '#4a1d96', label: 'Rodas'      },
    'cuauhtemoc':    { bg: '#d1fae5', color: '#064e3b', label: 'Cuauhtémoc' },
    'ordonez':       { bg: '#fef3c7', color: '#78350f', label: 'Ordóñez'    },
  };

  // Mapeo nombre de sucursal → id para los badges
  var SUC_NAME_TO_ID = {
    'Simón Bolívar': 'simon-bolivar', 'Insurgentes': 'insurgentes',
    'Antígona': 'antigona',           'Lincoln Oxxo': 'lincoln-oxxo',
    'Lincoln 2': 'lincoln-2',         'Ruiz Cortines': 'ruiz-cortines',
    'Rodas': 'rodas',                 'Cuauhtémoc': 'cuauhtemoc',
    'Ordóñez': 'ordonez',
  };

  var vntPeriodo  = '7';
  var vntSucursal = 'todas';
  var vntTopCat   = 'todas';
  var vntData     = null;
  var vntCargado  = false;

  function fmt(n) { return '$' + n.toLocaleString('es-MX'); }
  function fmtDelta(d) { return (d >= 0 ? '+' : '') + d.toFixed(1) + '%'; }

  // Pills de período
  document.querySelectorAll('.vnt-pill').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.vnt-pill').forEach(function (b) { b.classList.remove('active'); });
      this.classList.add('active');
      vntPeriodo = this.dataset.periodo;
      vntCargar();
    });
  });

  // Filtro de sucursal
  var vntSucSel = document.getElementById('vnt-suc-filter');
  if (vntSucSel) vntSucSel.addEventListener('change', function () {
    vntSucursal = this.value;
    vntCargar();
  });

  // Filtro de categoría en top productos
  var vntTopSel = document.getElementById('vnt-top-cat-filter');
  if (vntTopSel) vntTopSel.addEventListener('change', function () {
    vntTopCat = this.value;
    vntCargarTop();
  });

  // Exportar CSV
  var vntExpBtn = document.getElementById('vnt-export-btn');
  if (vntExpBtn) vntExpBtn.addEventListener('click', vntExportar);

  // Activar carga cuando se entra a la sección Ventas
  var vntNavBtn = document.querySelector('[data-seccion="ventas"]');
  if (vntNavBtn) vntNavBtn.addEventListener('click', function () {
    if (!vntCargado) vntCargar();
  });

  // ── carga principal ────────────────────────────────────────────────────────

  async function vntCargar() {
    try {
      var r = await fetch('/api/ventas?sucursal=' + vntSucursal + '&periodo=' + vntPeriodo);
      vntData    = await r.json();
      vntCargado = true;
      vntRenderKpis();
      vntRenderDesglose();
      vntRenderTabla();
      vntCargarTop();
      vntCargarAlertas();
    } catch (e) { console.error('Ventas:', e); }
  }

  // ── KPIs ───────────────────────────────────────────────────────────────────

  function vntRenderKpis() {
    if (!vntData) return;
    var d = vntData;
    var el = function (id) { return document.getElementById(id); };

    if (el('vnt-k-total'))       el('vnt-k-total').textContent   = fmt(d.totalGeneral);
    if (el('vnt-k-activas'))     el('vnt-k-activas').textContent  = d.desglose.length + ' / 9';
    if (el('vnt-k-top-suc') && d.topSucursal)  el('vnt-k-top-suc').textContent  = d.topSucursal.nombre;
    if (el('vnt-k-top-suc-val') && d.topSucursal) {
      el('vnt-k-top-suc-val').textContent = fmt(d.topSucursal.total);
      el('vnt-k-top-suc-val').style.color = 'var(--texto-suave)';
    }
    if (el('vnt-k-top-cat') && d.topCategoria) {
      el('vnt-k-top-cat').textContent    = d.topCategoria.nombre;
      el('vnt-k-top-cat').style.color    = CAT_COLOR[d.topCategoria.nombre] || 'var(--texto)';
    }
    if (el('vnt-k-top-cat-val') && d.topCategoria) {
      el('vnt-k-top-cat-val').textContent = fmt(d.topCategoria.total);
      el('vnt-k-top-cat-val').style.color = 'var(--texto-suave)';
    }
    if (el('vnt-k-delta')) {
      var pos = d.deltaPromedio >= 0;
      el('vnt-k-delta').textContent = fmtDelta(d.deltaPromedio) + ' vs período anterior';
      el('vnt-k-delta').className   = 'vnt-kpi-delta ' + (pos ? 'vnt-delta-pos' : 'vnt-delta-neg');
    }
  }

  // ── Desglose por sucursal (grid 3×3) ──────────────────────────────────────

  function vntRenderDesglose() {
    if (!vntData) return;
    var grid = document.getElementById('vnt-suc-grid');
    if (!grid) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];

    grid.innerHTML = vntData.desglose.map(function (suc) {
      var maxCat = Math.max.apply(null, cats.map(function (c) { return suc.categorias[c] || 0; }));
      var pos    = suc.delta >= 0;

      var barras = cats.map(function (cat) {
        var val = suc.categorias[cat] || 0;
        var pct = maxCat > 0 ? Math.round(val / maxCat * 100) : 0;
        var col = CAT_COLOR[cat];
        return '<div class="vnt-barra-row">' +
          '<span class="vnt-barra-label" style="color:' + col + '">' + cat + '</span>' +
          '<div class="vnt-barra-track">' +
            '<div class="vnt-barra-fill" style="width:' + pct + '%;background:' + col + '"></div>' +
          '</div>' +
          '<span class="vnt-barra-val">' + fmt(val) + '</span>' +
        '</div>';
      }).join('');

      var deltaHtml = pos
        ? '<span class="vnt-delta-pos">↑ ' + fmtDelta(suc.delta) + '</span>'
        : '<span class="vnt-delta-neg">↓ ' + fmtDelta(suc.delta) + '</span>';

      return '<div class="vnt-suc-card">' +
        '<div class="vnt-suc-card-head">' +
          '<span class="vnt-suc-card-nombre">' + suc.nombre + '</span>' +
          deltaHtml +
        '</div>' +
        '<div class="vnt-suc-card-total">' + fmt(suc.total) + '</div>' +
        barras +
      '</div>';
    }).join('');
  }

  // ── Tabla comparativa (3 cat × 9 suc) ─────────────────────────────────────

  function vntRenderTabla() {
    if (!vntData) return;
    var tabla = document.getElementById('vnt-tabla');
    if (!tabla) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];
    var sucs = vntData.desglose;

    // Abreviaciones para cabecera de columna
    var abr = function (n) {
      return n.replace('Simón Bolívar', 'S.Bolívar')
               .replace('Lincoln Oxxo', 'L.Oxxo')
               .replace('Lincoln 2',    'L.2')
               .replace('Ruiz Cortines','R.Cortines');
    };

    var html = '<thead><tr><th class="vnt-th-cat">Categoría</th>';
    sucs.forEach(function (s) { html += '<th>' + abr(s.nombre) + '</th>'; });
    html += '</tr></thead><tbody>';

    cats.forEach(function (cat) {
      var col    = CAT_COLOR[cat];
      var vals   = sucs.map(function (s) { return s.categorias[cat] || 0; });
      var maxVal = Math.max.apply(null, vals);

      html += '<tr><td><span class="vnt-cat-dot" style="background:' + col + '"></span>' + cat + '</td>';
      sucs.forEach(function (s) {
        var val   = s.categorias[cat] || 0;
        var ganó  = val === maxVal && maxVal > 0;
        html += '<td class="' + (ganó ? 'vnt-winner' : '') + '">' + (ganó ? '🏆 ' : '') + fmt(val) + '</td>';
      });
      html += '</tr>';
    });

    html += '</tbody>';
    tabla.innerHTML = html;
  }

  // ── Top productos ──────────────────────────────────────────────────────────

  async function vntCargarTop() {
    var tb = document.getElementById('vnt-top-body');
    if (!tb) return;
    tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Cargando…</td></tr>';
    try {
      var r    = await fetch('/api/ventas/top-productos?categoria=' + vntTopCat + '&periodo=' + vntPeriodo);
      var data = await r.json();
      if (!data.length) { tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Sin datos</td></tr>'; return; }
      tb.innerHTML = data.map(function (p, i) {
        var sid   = SUC_NAME_TO_ID[p.sucursal] || '';
        var badge = SUC_BADGE[sid] || { bg: '#f3f4f6', color: '#374151', label: p.sucursal };
        var catCol = CAT_COLOR[p.categoria] || '#666';
        return '<tr>' +
          '<td style="font-weight:700;color:var(--texto-suave);font-size:.75rem">' + (i + 1) + '</td>' +
          '<td>' +
            '<span style="font-size:.6rem;padding:2px 6px;border-radius:99px;background:' + catCol + '22;color:' + catCol + ';font-weight:700;margin-right:4px">' + p.categoria[0] + '</span>' +
            '<span style="font-size:.8rem">' + p.nombre + '</span>' +
          '</td>' +
          '<td><span style="font-size:.68rem;padding:2px 7px;border-radius:99px;background:' + badge.bg + ';color:' + badge.color + ';font-weight:600">' + badge.label + '</span></td>' +
          '<td style="text-align:right;font-size:.8rem;font-weight:600">' + p.unidades.toLocaleString('es-MX') + '</td>' +
          '<td style="text-align:right;font-size:.8rem;font-weight:700;color:var(--texto)">' + fmt(p.venta) + '</td>' +
        '</tr>';
      }).join('');
    } catch (e) {
      tb.innerHTML = '<tr><td colspan="5" class="vnt-empty">Error al cargar</td></tr>';
    }
  }

  // ── Alertas de rotación ────────────────────────────────────────────────────

  async function vntCargarAlertas() {
    var lista = document.getElementById('vnt-alertas-list');
    if (!lista) return;
    try {
      var r    = await fetch('/api/ventas/alertas');
      var data = await r.json();
      if (!data.length) {
        lista.innerHTML = '<div class="vnt-alerta-empty"><i class="ti ti-checks"></i><span>Sin alertas activas</span></div>';
        return;
      }
      lista.innerHTML = data.map(function (a) {
        var peligro = a.tipo === 'quiebre';
        return '<div class="vnt-alerta-card ' + (peligro ? 'vnt-alerta-danger' : 'vnt-alerta-warning') + '">' +
          '<div class="vnt-alerta-ico">' +
            (peligro ? '<i class="ti ti-flame"></i>' : '<i class="ti ti-package"></i>') +
          '</div>' +
          '<div class="vnt-alerta-body">' +
            '<p class="vnt-alerta-prod">' + a.producto + '</p>' +
            '<p class="vnt-alerta-meta">' + a.sucursal + ' · Stock: ' + a.stock + ' · ' + a.vendidos7 + ' uds/7d</p>' +
            '<p class="vnt-alerta-msg">' + a.mensaje + '</p>' +
          '</div>' +
          '<span class="vnt-alerta-tag">' + (peligro ? 'Quiebre' : 'Estancada') + '</span>' +
        '</div>';
      }).join('');
    } catch (e) {
      lista.innerHTML = '<div class="vnt-alerta-empty">Error al cargar alertas</div>';
    }
  }

  // ── Exportar CSV ───────────────────────────────────────────────────────────

  function vntExportar() {
    if (!vntData) return;
    var cats = ['Novedades', 'Papelería', 'Snack'];
    var csv  = 'Sucursal,' + cats.join(',') + ',Total\n';
    vntData.desglose.forEach(function (s) {
      var vals = cats.map(function (c) { return s.categorias[c] || 0; });
      csv += s.nombre + ',' + vals.join(',') + ',' + s.total + '\n';
    });
    var blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href   = url;
    a.download = 'ventas_' + vntPeriodo + 'd.csv';
    a.click();
    URL.revokeObjectURL(url);
  }

})();

// =============================================================
//  TICKETS DEL SYNC — verifica ventas reales desde CyberPlanet
// =============================================================
(function () {
  var btnConsultar = document.getElementById('btn-consultar-tickets');
  var tktFecha     = document.getElementById('tkt-fecha');
  var tktSucursal  = document.getElementById('tkt-sucursal');
  var tktBody      = document.getElementById('tkt-body');
  var tktResumen   = document.getElementById('tkt-resumen');

  // Pre-llenar con fecha de hoy en hora México
  if (tktFecha) {
    var hoyMx = new Date(Date.now() - 6 * 60 * 60 * 1000);
    tktFecha.value = hoyMx.toISOString().split('T')[0];
  }

  function fmt(n) { return '$' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function consultarTickets() {
    if (!tktBody) return;
    var suc   = tktSucursal ? tktSucursal.value : '';
    var fecha = tktFecha    ? tktFecha.value    : '';

    tktBody.innerHTML = '<tr><td colspan="3" class="vnt-empty">Consultando…</td></tr>';
    if (tktResumen) tktResumen.textContent = '';

    fetch('/api/tickets/dia?sucursal=' + encodeURIComponent(suc) + '&fecha=' + encodeURIComponent(fecha))
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.ok) {
          tktBody.innerHTML = '<tr><td colspan="3" class="vnt-empty" style="color:#f87171">Error: ' + (d.error || 'desconocido') + '</td></tr>';
          return;
        }
        if (tktResumen) {
          tktResumen.innerHTML = '<strong>' + d.numTickets + ' tickets</strong> · Total: <strong>' + fmt(d.total) + '</strong>';
        }
        if (!d.resumenProductos || d.resumenProductos.length === 0) {
          tktBody.innerHTML = '<tr><td colspan="3" class="vnt-empty">Sin ventas registradas para esa fecha y sucursal.</td></tr>';
          return;
        }
        tktBody.innerHTML = d.resumenProductos.map(function(p) {
          return '<tr>' +
            '<td>' + p.detalle + '</td>' +
            '<td style="text-align:right">' + p.unidades + '</td>' +
            '<td style="text-align:right">' + fmt(p.importe) + '</td>' +
          '</tr>';
        }).join('');
      })
      .catch(function(err) {
        tktBody.innerHTML = '<tr><td colspan="3" class="vnt-empty" style="color:#f87171">Error de red: ' + err.message + '</td></tr>';
      });
  }

  if (btnConsultar) btnConsultar.addEventListener('click', consultarTickets);
})();

// =============================================================
//  DASHBOARD — carga datos de /api/resumen + /api/ventas + /api/ventas/alertas
// =============================================================
(function () {
  var CAT_COLORS = { Novedades: '#c0392b', 'Papelería': '#e67e22', Snack: '#27ae60' };

  function set(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; }
  function html(id, h)  { var el = document.getElementById(id); if (el) el.innerHTML  = h; }
  function fmt(n) { return '$' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 0 }); }

  // ── Widgets ────────────────────────────────────────────────

  function renderCategorias(ventasData) {
    var cats = ventasData.porCategoria || {};
    var total = Object.values(cats).reduce(function (s, v) { return s + v; }, 0) || 1;
    var rows  = Object.keys(cats).map(function (cat) {
      var val  = cats[cat] || 0;
      var pct  = Math.round(val / total * 100);
      var color = CAT_COLORS[cat] || '#888';
      return '<div class="dash-cat-row">' +
        '<span class="dash-cat-dot" style="background:' + color + '"></span>' +
        '<span class="dash-cat-name">' + cat + '</span>' +
        '<div class="dash-cat-bar-wrap"><div class="dash-cat-bar" style="width:' + pct + '%;background:' + color + '"></div></div>' +
        '<span class="dash-cat-val">' + fmt(val) + '</span>' +
      '</div>';
    });

    if (!rows.length) { html('dash-cat-wrap', '<div class="dash-empty"><i class="ti ti-chart-bar-off"></i>Sin datos</div>'); return; }
    html('dash-cat-wrap', '<div style="display:flex;flex-direction:column;gap:10px">' + rows.join('') + '</div>');

    var top = ventasData.topSucursal;
    if (top) set('dash-vnt-footer', 'Mejor sucursal: ' + top.nombre + ' · ' + fmt(top.total));
  }

  function renderAlertas(alertas) {
    if (!alertas || !alertas.length) {
      html('dash-alertas-wrap', '<div class="dash-empty"><i class="ti ti-check"></i>Sin alertas de stock</div>');
      return;
    }
    var items = alertas.slice(0, 5).map(function (a) {
      return '<div class="dash-alerta-item">' +
        '<div class="dash-alerta-ico ' + a.tipo + '">' +
          (a.tipo === 'quiebre' ? '<i class="ti ti-alert-triangle"></i>' : '<i class="ti ti-clock-pause"></i>') +
        '</div>' +
        '<div class="dash-alerta-body">' +
          '<div class="dash-alerta-prod">' + a.producto + '</div>' +
          '<div class="dash-alerta-suc">' + a.sucursal + '</div>' +
          '<div class="dash-alerta-msg ' + a.tipo + '">' + a.mensaje + '</div>' +
        '</div>' +
        '<div class="dash-alerta-stock ' + a.tipo + '">' + a.stock + ' uds</div>' +
      '</div>';
    });
    html('dash-alertas-wrap', items.join(''));
  }

  function renderReportesRecientes(reportes) {
    if (!reportes || !reportes.length) {
      html('dash-rpt-wrap', '<div class="dash-empty"><i class="ti ti-report-off"></i>Sin reportes</div>');
      return;
    }
    var items = reportes.slice(0, 5).map(function (r) {
      var fecha = r.fecha ? new Date(r.fecha).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }) : '';
      return '<div class="dash-rpt-item">' +
        '<span class="dash-rpt-dot ' + r.status + '"></span>' +
        '<div class="dash-rpt-body">' +
          '<div class="dash-rpt-desc">' + escHtml(r.descripcion) + '</div>' +
          '<div class="dash-rpt-meta">' + escHtml(r.sucursal) + ' · ' + escHtml(r.dept) + ' · ' + fecha + '</div>' +
        '</div>' +
      '</div>';
    });
    html('dash-rpt-wrap', items.join(''));
  }

  function renderTopProductos(productos) {
    if (!productos || !productos.length) {
      html('dash-top-wrap', '<div class="dash-empty"><i class="ti ti-package-off"></i>Sin datos</div>');
      return;
    }
    var maxU = productos[0].unidades || 1;
    var rows = productos.slice(0, 7).map(function (p, i) {
      var pct = Math.round(p.unidades / maxU * 100);
      return '<div class="dash-rank-row">' +
        '<span class="dash-rank-num">' + (i + 1) + '</span>' +
        '<div style="flex:1;min-width:0">' +
          '<div class="dash-rank-name">' + p.nombre + '</div>' +
          '<div style="height:4px;background:var(--borde);border-radius:3px;margin-top:3px">' +
            '<div style="height:100%;width:' + pct + '%;background:var(--acento);border-radius:3px"></div>' +
          '</div>' +
        '</div>' +
        '<span class="dash-rank-cat">' + p.categoria + '</span>' +
        '<span class="dash-rank-val">' + p.unidades + ' uds</span>' +
      '</div>';
    });
    html('dash-top-wrap', rows.join(''));
  }

  function renderRankingSucursales(desglose) {
    if (!desglose || !desglose.length) {
      html('dash-suc-wrap', '<div class="dash-empty"><i class="ti ti-building-off"></i>Sin datos</div>');
      return;
    }
    var sorted = desglose.slice().sort(function (a, b) { return b.total - a.total; });
    var maxT   = sorted[0].total || 1;
    var rows   = sorted.map(function (s, i) {
      var pct = Math.round(s.total / maxT * 100);
      var deltaSign = s.delta >= 0 ? '+' : '';
      var deltaClass = s.delta >= 0 ? 'pos' : 'neg';
      return '<div class="dash-rank-row">' +
        '<span class="dash-rank-num">' + (i + 1) + '</span>' +
        '<div style="flex:1;min-width:0">' +
          '<div class="dash-rank-name">' + s.nombre + '</div>' +
          '<div style="height:4px;background:var(--borde);border-radius:3px;margin-top:3px">' +
            '<div style="height:100%;width:' + pct + '%;background:#c0392b;border-radius:3px"></div>' +
          '</div>' +
        '</div>' +
        '<span class="dash-rank-val">' + fmt(s.total) + '</span>' +
        '<span class="dash-rank-delta ' + deltaClass + '">' + deltaSign + s.delta + '%</span>' +
      '</div>';
    });
    html('dash-suc-wrap', rows.join(''));
  }

  // ── Carga principal ────────────────────────────────────────

  async function dashCargar() {
    var resultados = await Promise.allSettled([
      fetch('/api/resumen').then(function (r) { return r.ok ? r.json() : null; }),
      fetch('/api/ventas?periodo=7').then(function (r) { return r.ok ? r.json() : null; }),
      fetch('/api/ventas/alertas').then(function (r) { return r.ok ? r.json() : null; }),
      fetch('/api/ventas/top-productos?periodo=7').then(function (r) { return r.ok ? r.json() : null; }),
      fetch('/api/reportes').then(function (r) { return r.ok ? r.json() : null; }),
    ]);

    var resumen  = resultados[0].value;
    var ventas   = resultados[1].value;
    var alertas  = resultados[2].value;
    var tops     = resultados[3].value;
    var reportes = resultados[4].value;

    // KPI — resumen general
    if (resumen) {
      set('dash-cnt-emp', resumen.empleados);
      set('dash-sub-emp', resumen.empleados === 1 ? '1 empleado activo' : (resumen.empleados || 0) + ' activos');
      set('dash-cnt-cli', resumen.clientes);
      set('dash-sub-cli', resumen.clientes + ' en el sistema');
    }

    // KPI — ventas 7d
    if (ventas) {
      set('dash-vnt-total', fmt(ventas.totalGeneral));
      set('dash-vnt-sub', 'vs sem. ant.: ' + (ventas.deltaPromedio >= 0 ? '+' : '') + (ventas.deltaPromedio || 0) + '%');
      renderCategorias(ventas);
      renderRankingSucursales(ventas.desglose || []);
    } else {
      html('dash-cat-wrap', '<div class="dash-empty"><i class="ti ti-wifi-off"></i>Sin conexión</div>');
    }

    // KPI — alertas de stock
    if (alertas) {
      set('dash-stk-cnt', alertas.length);
      set('dash-stk-sub', alertas.filter(function (a) { return a.tipo === 'quiebre'; }).length + ' quiebres · ' +
                          alertas.filter(function (a) { return a.tipo === 'estancada'; }).length + ' estancadas');
      renderAlertas(alertas);
    }

    // Widgets adicionales
    renderTopProductos(tops);
    renderReportesRecientes(reportes);
  }

  dashCargar();
  document.querySelector('[data-seccion="dashboard"]')?.addEventListener('click', dashCargar);
})();

// ── Inventario: descarga de Excel con stock actual ──────────────────────────
function descargarInventario(categoria) {
  const sucursal = document.getElementById('inv-sucursal')?.value;
  if (!sucursal || sucursal === 'Todas las sucursales') {
    alert('Selecciona una sucursal específica para descargar el inventario.');
    return;
  }
  const fechaInput = document.getElementById('inv-fecha')?.value;
  const hoy = new Date();
  const fechaHoy = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
  const fecha = fechaInput || fechaHoy;
  const url = `/api/inventario/descargar?sucursal=${encodeURIComponent(sucursal)}&categoria=${categoria}&fecha=${fecha}`;
  const a = document.createElement('a');
  a.href = url;
  a.style.display = 'none';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

</script>

<!-- ============================================================
     ASISTENCIA — QR personal de 2 minutos + reporte (solo admin)
     ============================================================ -->
<script>
(function () {
  var asisExpiraEn = null;
  var asisIntervalId = null;
  var asisTokenActual = null;
  var asisRepFecha = new Date();

  var ETIQUETAS_BOTON = {
    entrada:       { texto: 'Marcar entrada',   icono: 'ti-door-enter', clase: 'as-btn-entrada' },
    salida:        { texto: 'Marcar salida',    icono: 'ti-door-exit',  clase: 'as-btn-salida' },
    inicio_comida: { texto: 'Iniciar comida',   icono: 'ti-coffee',     clase: 'as-btn-comida' },
    fin_comida:    { texto: 'Terminar comida',  icono: 'ti-coffee-off', clase: 'as-btn-entrada' },
  };

  var ESTADO_TXT = {
    fuera:      'Estás fuera de turno.',
    trabajando: 'Estás trabajando.',
    en_comida:  'Estás en tu tiempo de comida.',
  };

  function asisOcultarQr() {
    var card = document.getElementById('asis-qr-card');
    if (card) card.style.display = 'none';
    if (asisIntervalId) { clearInterval(asisIntervalId); asisIntervalId = null; }
    asisTokenActual = null;
    asisExpiraEn = null;
  }

  async function asisCargarEstado() {
    var estadoTxt   = document.getElementById('asis-estado-txt');
    var botonesWrap = document.getElementById('asis-botones-tipo');
    var sucSel      = document.getElementById('asis-sucursal');
    if (!estadoTxt || !botonesWrap || !sucSel) return;

    asisOcultarQr();
    estadoTxt.textContent = 'Cargando tu estado...';
    botonesWrap.textContent = '';

    try {
      var resp = await fetch('/asistencia/api/estado');
      var data = await resp.json();
      if (!resp.ok) { estadoTxt.textContent = data.error || 'No se pudo cargar tu estado.'; return; }

      estadoTxt.textContent = ESTADO_TXT[data.estado] || '';

      if (sucSel.options.length === 0) {
        (data.sucursales || []).forEach(function (s) {
          var opt = document.createElement('option');
          opt.value = s;
          opt.textContent = s;
          sucSel.appendChild(opt);
        });
      }

      (data.opciones || []).forEach(function (tipo) {
        var meta = ETIQUETAS_BOTON[tipo];
        if (!meta) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'as-btn ' + meta.clase;
        var icon = document.createElement('i');
        icon.className = 'ti ' + meta.icono;
        btn.appendChild(icon);
        btn.appendChild(document.createTextNode(' ' + meta.texto));
        btn.addEventListener('click', function () { asisGenerarQr(tipo); });
        botonesWrap.appendChild(btn);
      });
    } catch (e) {
      estadoTxt.textContent = 'Error de conexión.';
    }
  }

  async function asisGenerarQr(tipo) {
    var sucSel = document.getElementById('asis-sucursal');
    var sucursal = sucSel ? sucSel.value : '';
    if (!sucursal) { alert('Elegí una sucursal.'); return; }

    try {
      var resp = await fetch('/asistencia/api/generar-qr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipo, sucursal: sucursal }),
      });
      var data = await resp.json();
      if (!resp.ok) { alert(data.error || 'No se pudo generar el código.'); return; }

      asisTokenActual = data.token;
      asisExpiraEn = data.expiresAt;

      var card  = document.getElementById('asis-qr-card');
      var img   = document.getElementById('asis-qr-img');
      var boton = document.getElementById('asis-btn-regenerar');
      if (img) { img.src = data.qrDataUrl; img.classList.remove('asis-qr-img--vencido'); }
      if (boton) boton.style.display = 'none';
      var countdown = document.getElementById('asis-qr-countdown');
      if (countdown) countdown.classList.remove('asis-qr-countdown--vencido');
      if (card) card.style.display = 'block';

      if (asisIntervalId) clearInterval(asisIntervalId);
      asisTickCountdown();
      asisIntervalId = setInterval(asisTickCountdown, 1000);
    } catch (e) {
      alert('Error de conexión al generar el código.');
    }
  }

  function asisTickCountdown() {
    var el    = document.getElementById('asis-qr-countdown');
    var img   = document.getElementById('asis-qr-img');
    var boton = document.getElementById('asis-btn-regenerar');
    if (!el || !asisExpiraEn) return;

    var restanteMs = asisExpiraEn - Date.now();
    if (restanteMs <= 0) {
      el.textContent = 'Código vencido';
      el.classList.add('asis-qr-countdown--vencido');
      if (img) img.classList.add('asis-qr-img--vencido');
      if (boton) boton.style.display = 'block';
      if (asisIntervalId) { clearInterval(asisIntervalId); asisIntervalId = null; }
      return;
    }

    var totalSeg = Math.ceil(restanteMs / 1000);
    var min = Math.floor(totalSeg / 60);
    var seg = totalSeg % 60;
    el.textContent = min + ':' + String(seg).padStart(2, '0');
  }

  async function asisAutoConfirmar() {
    if (!asisTokenActual) return;
    try {
      var resp = await fetch('/asistencia/api/autoconfirmar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: asisTokenActual }),
      });
      var data = await resp.json();
      if (!resp.ok) { alert(data.error || 'No se pudo autoconfirmar.'); return; }
      asisCargarEstado();
    } catch (e) {
      alert('Error de conexión.');
    }
  }

  // ── Semana viernes→jueves — misma lógica que src/routes/asistencia.js
  //    y public/js/horarios.js, portada acá para poder mostrar el rango de
  //    fechas del reporte sin ir al servidor por cada flecha ◀▶.
  function asisIsoWeekStr(date) {
    var d = new Date(date);
    d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() + 4 - (d.getDay() || 7));
    var yearStart = new Date(d.getFullYear(), 0, 1);
    var weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
    return d.getFullYear() + '-' + String(weekNo).padStart(2, '0');
  }

  function asisGetViernesDeISO(weekStr) {
    var partes = weekStr.split('-');
    var year = parseInt(partes[0], 10);
    var week = parseInt(partes[1], 10);
    var jan4 = new Date(year, 0, 4);
    var dayOfWeek = (jan4.getDay() + 6) % 7;
    var monday = new Date(jan4);
    monday.setDate(jan4.getDate() - dayOfWeek + (week - 1) * 7);
    var viernes = new Date(monday);
    viernes.setDate(monday.getDate() - 3);
    viernes.setHours(0, 0, 0, 0);
    return viernes;
  }

  async function asisCargarReporte() {
    var tbody = document.getElementById('asis-rep-body');
    var empty = document.getElementById('asis-rep-empty');
    var semanaTxt = document.getElementById('asis-rep-semana-txt');
    if (!tbody) return;

    var semana = asisIsoWeekStr(asisRepFecha);
    var sucursal = document.getElementById('asis-rep-sucursal')?.value || 'todas';
    var soloIncompletos = document.getElementById('asis-rep-incompletos')?.checked ? '1' : '0';

    var viernes = asisGetViernesDeISO(semana);
    var jueves = new Date(viernes);
    jueves.setDate(viernes.getDate() + 6);
    var fmt = function (d) { return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' }); };
    if (semanaTxt) semanaTxt.textContent = 'Semana ' + fmt(viernes) + ' – ' + fmt(jueves);

    tbody.textContent = '';
    if (empty) empty.style.display = 'none';

    try {
      var url = '/asistencia/api/reporte?semana=' + encodeURIComponent(semana) +
                 '&sucursal=' + encodeURIComponent(sucursal) +
                 '&soloIncompletos=' + soloIncompletos;
      var resp = await fetch(url);
      var data = await resp.json();
      if (!resp.ok) {
        if (empty) { empty.textContent = data.error || 'Error al cargar el reporte.'; empty.style.display = 'block'; }
        return;
      }

      var filas = data.filas || [];
      if (filas.length === 0) {
        if (empty) { empty.textContent = 'Sin marcaciones para este filtro.'; empty.style.display = 'block'; }
        return;
      }

      var horaFmt = function (iso) { return new Date(iso).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }); };

      filas.forEach(function (f) {
        var tr = document.createElement('tr');
        var celdas = [
          f.nombre, f.sucursal, f.fecha,
          horaFmt(f.horaEntrada), horaFmt(f.horaSalida),
          f.horasTrabajadas.toFixed(2) + 'h',
          f.horasEsperadas != null ? f.horasEsperadas.toFixed(2) + 'h' : '—',
          f.diferencia != null ? (f.diferencia > 0 ? '+' : '') + f.diferencia.toFixed(2) + 'h' : '—',
          f.confirmadoPor || '—',
        ];
        celdas.forEach(function (val, idx) {
          var td = document.createElement('td');
          td.textContent = val;
          if (idx === 7 && f.diferencia != null) {
            td.className = f.diferencia < 0 ? 'asis-diff-neg' : 'asis-diff-pos';
          }
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
    } catch (e) {
      if (empty) { empty.textContent = 'Error de conexión.'; empty.style.display = 'block'; }
    }
  }

  function asisMostrarTab(tab) {
    var btnMarcar = document.getElementById('asis-tab-marcar');
    var btnReporte = document.getElementById('asis-tab-reporte');
    var viewMarcar = document.getElementById('asis-view-marcar');
    var viewReporte = document.getElementById('asis-view-reporte');
    if (!btnMarcar || !viewMarcar) return;

    var esReporte = (tab === 'reporte' && viewReporte);
    btnMarcar.classList.toggle('hor-tab--active', !esReporte);
    if (btnReporte) btnReporte.classList.toggle('hor-tab--active', !!esReporte);
    viewMarcar.style.display = esReporte ? 'none' : 'block';
    if (viewReporte) viewReporte.style.display = esReporte ? 'block' : 'none';
    if (esReporte) asisCargarReporte();
  }

  document.getElementById('asis-btn-autoconfirmar')?.addEventListener('click', asisAutoConfirmar);
  document.getElementById('asis-btn-regenerar')?.addEventListener('click', asisCargarEstado);
  document.getElementById('asis-tab-marcar')?.addEventListener('click', function () { asisMostrarTab('marcar'); });
  document.getElementById('asis-tab-reporte')?.addEventListener('click', function () { asisMostrarTab('reporte'); });
  document.getElementById('asis-rep-sucursal')?.addEventListener('change', asisCargarReporte);
  document.getElementById('asis-rep-incompletos')?.addEventListener('change', asisCargarReporte);
  document.getElementById('asis-rep-prev')?.addEventListener('click', function () {
    asisRepFecha.setDate(asisRepFecha.getDate() - 7);
    asisCargarReporte();
  });
  document.getElementById('asis-rep-next')?.addEventListener('click', function () {
    asisRepFecha.setDate(asisRepFecha.getDate() + 7);
    asisCargarReporte();
  });

  document.querySelector('[data-seccion="asistencia"]')?.addEventListener('click', asisCargarEstado);
})();
</script>

