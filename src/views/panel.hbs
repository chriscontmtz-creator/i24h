const CAUSAS_FALTA = ['Selecciona causa…','Merma / daño','Venta no registrada','Error conteo turno anterior','Robo o extravío','Surtido no aplicado','Otro'];
const CAUSAS_SOBRA = ['Selecciona causa…','Error conteo turno anterior','Devolución no registrada','Material Encontrado','Otro'];

var conteosBitacora  = {};
var bitacoraIniciada = false;

function aplicarStockBitacora(productos) {
  var mapa = {};
  productos.forEach(function(p) {
    mapa[p.nombre.toLowerCase().trim()] = p.stock;
  });
  PRODUCTOS_BITACORA.forEach(function(cat) {
    cat.items.forEach(function(item) {
      if (!item.cyber) return;
      var val = mapa[item.cyber];
      if (val !== undefined) {
        item.esperado     = val;
        item.stockInicial = val;
      }
    });
  });
}

// ── render ──────────────────────────────────────────────────────────────

function renderBitacora() {
  var cont = document.getElementById('bit-categorias');
  if (!cont) return;
  var html = '';

  PRODUCTOS_BITACORA.forEach(function(cat, ci) {
    var contados = cat.items.filter(function(_, ii) {
      return conteosBitacora[ci + '_' + ii] && conteosBitacora[ci + '_' + ii].valor !== null;
    }).length;

    html += '<div class="bit-cat-bloque">' +
      '<div class="bit-cat-head">' +
        '<i class="ti ' + cat.icono + '" style="font-size:16px;color:var(--acento)"></i>' +
        '<span class="bit-cat-titulo">' + cat.cat + '</span>' +
        '<span class="bit-cat-contador">' + contados + ' / ' + cat.items.length + '</span>' +
      '</div>' +
      '<div class="bit-col-headers">' +
        '<span class="bit-col-h">Producto</span>' +
        '<span class="bit-col-h">Esperado</span>' +
        '<span class="bit-col-h">Conteo</span>' +
        '<span class="bit-col-h">Diferencia</span>' +
      '</div>';

    cat.items.forEach(function(item, ii) {
      var key    = ci + '_' + ii;
      var estado = conteosBitacora[key];
      var val    = estado ? estado.valor : null;
      var diff   = val !== null ? val - item.esperado : null;
      var bClass = val === null ? 'bit-badge-vacio'
                 : diff === 0  ? 'bit-badge-ok'
                 : diff < 0    ? 'bit-badge-falta'
                               : 'bit-badge-sobra';
      var bText  = val === null ? '—'
                 : diff === 0  ? '✓ OK'
                 : diff < 0    ? (item.esperado + ' − ' + val + ' = −' + Math.abs(diff))
                               : (val + ' − ' + item.esperado + ' = +' + diff);
      var dis    = bitacoraIniciada ? '' : ' disabled';

      html += '<div class="bit-prod-fila">' +
        '<span class="bit-prod-nombre">' + item.nombre + '</span>' +
        '<span class="bit-prod-esperado">' + item.esperado + '</span>' +
        '<div class="bit-conteo-wrap">' +
          '<button class="bit-cbtn" data-key="' + key + '" data-esp="' + item.esperado + '" data-delta="-1"' + dis + '>−</button>' +
          '<input class="bit-cinp" type="number" min="0"' +
            ' value="' + (val !== null ? val : '') + '"' +
            ' placeholder="—"' +
            ' data-key="' + key + '" data-esp="' + item.esperado + '"' + dis + '>' +
          '<button class="bit-cbtn" data-key="' + key + '" data-esp="' + item.esperado + '" data-delta="1"' + dis + '>+</button>' +
          '<button class="bit-cbtn bit-cbtn-ok" data-key="' + key + '" data-esp="' + item.esperado + '" data-ok="1"' + dis + ' title="Sin diferencia">✓</button>' +
        '</div>' +
        '<span class="bit-badge ' + bClass + '">' + bText + '</span>' +
      '</div>';

      if (val !== null && diff !== 0) {
        var causas = diff < 0 ? CAUSAS_FALTA : CAUSAS_SOBRA;
        html += '<div class="bit-justif-fila">' +
          '<span class="bit-justif-label"><i class="ti ti-alert-circle"></i> Justificación</span>' +
          '<select class="bit-justif-select" data-key="' + key + '">' +
            causas.map(function(c) {
              return '<option value="' + c + '"' + (estado.justif === c ? ' selected' : '') + '>' + c + '</option>';
            }).join('') +
          '</select>' +
        '</div>';
      }
    });
    html += '</div>';
  });

  cont.innerHTML = html;

  // ── listeners directos tras cada render ────────────────────────────────
  if (bitacoraIniciada) {
    cont.querySelectorAll('[data-delta]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        var dlt = +this.dataset.delta;
        var act = conteosBitacora[k].valor !== null ? conteosBitacora[k].valor : esp;
        conteosBitacora[k].valor = Math.max(0, act + dlt);
        if (conteosBitacora[k].valor === esp) conteosBitacora[k].justif = '';
        renderBitacora();
      });
    });

    cont.querySelectorAll('[data-ok]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        conteosBitacora[k].valor = esp;
        conteosBitacora[k].justif = '';
        renderBitacora();
      });
    });

    cont.querySelectorAll('.bit-cinp').forEach(function(inp) {
      inp.addEventListener('input', function() {
        var k   = this.dataset.key;
        var esp = +this.dataset.esp;
        var n   = parseInt(this.value);
        if (!isNaN(n) && n >= 0) {
          conteosBitacora[k].valor = n;
          if (n === esp) conteosBitacora[k].justif = '';
          var fila  = this.closest('.bit-prod-fila');
          var badge = fila ? fila.querySelector('.bit-badge') : null;
          if (badge) {
            var d = n - esp;
            badge.className   = 'bit-badge ' + (d === 0 ? 'bit-badge-ok' : d < 0 ? 'bit-badge-falta' : 'bit-badge-sobra');
            badge.textContent = d === 0 ? '✓ OK' : d < 0 ? (esp + ' − ' + n + ' = −' + Math.abs(d)) : (n + ' − ' + esp + ' = +' + d);
          }
          actualizarResumen();
        }
      });
    });

    cont.querySelectorAll('.bit-justif-select').forEach(function(sel) {
      sel.addEventListener('change', function() {
        conteosBitacora[this.dataset.key].justif = this.value;
      });
    });
  }

  actualizarResumen();
}

// ── resumen de la barra superior ─────────────────────────────────────────

function actualizarResumen() {
  var ok = 0, falta = 0, sobra = 0, pendiente = 0;
  var total = Object.keys(conteosBitacora).length;

  Object.keys(conteosBitacora).forEach(function(key) {
    var estado = conteosBitacora[key];
    if (estado.valor === null) { pendiente++; return; }
    var partes = key.split('_');
    var ii = parseInt(partes[1]);
    var ci = parseInt(partes[0]);
    var cat  = PRODUCTOS_BITACORA[ci];
    var item = cat ? cat.items[ii] : null;
    if (!item) return;
    var diff = estado.valor - item.esperado;
    if (diff === 0) ok++; else if (diff < 0) falta++; else sobra++;
  });

  var contados = ok + falta + sobra;
  document.getElementById('res-ok').textContent        = ok;
  document.getElementById('res-falta').textContent     = falta;
  document.getElementById('res-sobra').textContent     = sobra;
  document.getElementById('res-pendiente').textContent = pendiente;
  var pct = total > 0 ? Math.round(contados / total * 100) : 0;
  document.getElementById('bit-prog-fill').style.width = pct + '%';
  document.getElementById('bit-prog-txt').textContent  = contados + ' / ' + total + ' productos';
}

// ── iniciar / cerrar bitácora ─────────────────────────────────────────────

// Turno según la hora actual (hora México): T1 07:00–15:00, T2 15:00–23:00, T3 23:00–07:00
function bitTurnoActual() {
  var horaMx = new Date(Date.now() - 6 * 60 * 60 * 1000).getUTCHours();
  if (horaMx >= 7  && horaMx < 15) return 0; // T1
  if (horaMx >= 15 && horaMx < 23) return 1; // T2
  return 2; // T3 (23:00–06:59)
}

function bitAutoSeleccionarTurno() {
  var sel = document.getElementById('bit-turno');
  if (sel) sel.selectedIndex = bitTurnoActual();
}

// Al abrir el panel, deja el turno correcto ya marcado
bitAutoSeleccionarTurno();

document.getElementById('btn-iniciar-conteo')?.addEventListener('click', function() {
  var btn      = this;
  var sucursal = document.getElementById('bit-sucursal')?.value || 'Simón Bolívar';

  // Auto-rellenar fecha y turno con el momento actual en hora México (UTC-6)
  var hoyMx = new Date(Date.now() - 6 * 60 * 60 * 1000);
  document.getElementById('bit-fecha').value = hoyMx.toISOString().split('T')[0];
  bitAutoSeleccionarTurno();

  btn.innerHTML = '<i class="ti ti-loader-2"></i> Cargando corte…';
  btn.disabled  = true;

  fetch('/api/bitacora/snapshot-corte?sucursal=' + encodeURIComponent(sucursal))
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var badge = document.getElementById('bit-sync-badge');
      if (d.ok && d.snapshot && d.snapshot.productos.length) {
        aplicarStockBitacora(d.snapshot.productos);
        var hora = new Date(d.snapshot.fechaCorte).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        if (badge) badge.innerHTML =
          '<i class="ti ti-circle-check" style="color:var(--exito)"></i> Stock del corte de ' +
          d.snapshot.turnoQueEntrega + ' · ' + hora;
      } else {
        if (badge) badge.innerHTML =
          '<i class="ti ti-alert-triangle" style="color:#f59e0b"></i> Sin snapshot disponible — ' +
          'el turno anterior aún no hizo corte. Esperado = 0';
      }
    })
    .catch(function() {
      var badge = document.getElementById('bit-sync-badge');
      if (badge) badge.innerHTML = '<i class="ti ti-wifi-off"></i> Sin conexión al servidor';
    })
    .finally(function() {
      bitacoraIniciada = true;
      btn.innerHTML = '<i class="ti ti-check"></i> Conteo activo';
      btn.style.background = '#16a34a';
      renderBitacora();
    });
});

document.getElementById('btn-cerrar-bitacora')?.addEventListener('click', function() {
  var pendiente = parseInt(document.getElementById('res-pendiente').textContent);
  if (pendiente > 0) {
    alert('Aún tienes ' + pendiente + ' productos sin contar. Completa el conteo antes de cerrar.');
    return;
  }
  if (!confirm('¿Confirmas que quieres cerrar la bitácora de este turno? No podrás modificarla después.')) return;

  // Recolectar datos
  var sucursal = document.getElementById('bit-sucursal').value;
  var turno    = document.getElementById('bit-turno').value;
  var fecha    = document.getElementById('bit-fecha').value;
  var prods    = [];

  PRODUCTOS_BITACORA.forEach(function(cat, ci) {
    cat.items.forEach(function(item, ii) {
      var key    = ci + '_' + ii;
      var estado = conteosBitacora[key] || {};
      var val    = estado.valor !== null && estado.valor !== undefined ? estado.valor : item.esperado;
      prods.push({
        categoria:     cat.cat,
        nombre:        item.nombre,
        stockInicial:  item.stockInicial !== undefined ? item.stockInicial : item.esperado,
        esperado:      item.esperado,
        conteo:        val,
        diferencia:    val - item.esperado,
        justificacion: estado.justif || '',
      });
    });
  });

  var resumen = {
    ok:        parseInt(document.getElementById('res-ok').textContent)        || 0,
    falta:     parseInt(document.getElementById('res-falta').textContent)     || 0,
    sobra:     parseInt(document.getElementById('res-sobra').textContent)     || 0,
    sinContar: parseInt(document.getElementById('res-pendiente').textContent) || 0,
  };

  fetch('/api/bitacora/guardar', {
    method:  'POST',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ sucursal, turno, fecha, productos: prods, resumen, responsable: window.BIT_USUARIO || '' }),
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.ok) {
      bitacoraIniciada = false;
      document.getElementById('btn-iniciar-conteo').disabled = false;
      document.getElementById('btn-iniciar-conteo').textContent = '✓ Bitácora guardada — Iniciar nuevo conteo';
      document.getElementById('btn-cerrar-bitacora').style.display = 'none';
      alert('Bitácora guardada correctamente.');
      bitCargarHistorial(sucursal);
    } else {
      alert('Error al guardar: ' + (data.error || 'desconocido'));
    }
  })
  .catch(function(err) {
    alert('Error de red al guardar la bitácora: ' + err.message);
  });
});

// ── bloqueo 15 min post-corte ─────────────────────────────────────────────
(function() {
  var CORTES_MIN = [7 * 60 + 10, 15 * 60 + 10, 21 * 60 + 50]; // 07:10, 15:10, 21:50 — horario del sync unificado
  var ESPERA    = 10; // desbloquea 10 min después de cada sync: 07:20 / 15:20 / 22:00

  function minutosMX() {
    var ahora = new Date();
    try {
      var parts = new Intl.DateTimeFormat('es-MX', {
        timeZone: 'America/Mexico_City',
        hour: '2-digit', minute: '2-digit', hour12: false
      }).formatToParts(ahora);
      var h = parseInt(parts.find(function(p){ return p.type === 'hour'; }).value);
      var m = parseInt(parts.find(function(p){ return p.type === 'minute'; }).value);
      return h * 60 + m;
    } catch(e) {
      var mx = new Date(ahora.getTime() - 6 * 60 * 60 * 1000);
      return mx.getUTCHours() * 60 + mx.getUTCMinutes();
    }
  }

  function minutosRestantes() {
    var actual = minutosMX();
    for (var i = 0; i < CORTES_MIN.length; i++) {
      var diff = actual - CORTES_MIN[i];
      if (diff < 0) diff += 24 * 60;
      if (diff >= 0 && diff < ESPERA) return ESPERA - diff;
    }
    return 0;
  }

  var btn   = document.getElementById('btn-iniciar-conteo');
  var badge = document.getElementById('bit-sync-badge');
  if (!btn) return;

  function actualizarEstado() {
    var restantes = minutosRestantes();
    if (restantes > 0) {
      btn.disabled = true;
      if (badge) badge.innerHTML =
        '<i class="ti ti-clock" style="color:#f59e0b"></i> ' +
        'El sync aún puede estar cargando — espera <strong>' + restantes + ' min' +
        (restantes === 1 ? 'uto' : 'utos') +
        '</strong> para que el Esperado sea correcto';
      return true;
    }
    return false;
  }

  if (actualizarEstado()) {
    var iv = setInterval(function() {
      if (!actualizarEstado()) {
        clearInterval(iv);
        btn.disabled = false;
        if (badge) badge.innerHTML =
          '<i class="ti ti-clock"></i> Presiona "Iniciar conteo" para cargar el stock del corte anterior';
      }
    }, 60 * 1000);
  }
})();

// ── Historial de bitácoras ────────────────────────────────────────────────────

function bitCargarHistorial(sucursal) {
  var url = '/api/bitacora/lista?limit=15' + (sucursal ? '&sucursal=' + encodeURIComponent(sucursal) : '');
  fetch(url)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.ok) return;
      var wrap = document.getElementById('bit-historial-lista');
      if (!wrap) return;
      if (data.docs.length === 0) {
        wrap.innerHTML = '<p class="bit-hist-vacio">Sin bitácoras guardadas aún.</p>';
        return;
      }
      wrap.innerHTML = data.docs.map(function(doc) {
        var fecha = new Date(doc.fecha).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' });
        var cierre = new Date(doc.fechaCierre).toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' });
        var ok    = doc.resumen ? doc.resumen.ok    : 0;
        var falta = doc.resumen ? doc.resumen.falta : 0;
        var sobra = doc.resumen ? doc.resumen.sobra : 0;
        return '<div class="bit-hist-fila" onclick="bitVerDetalle(\'' + escJs(doc._id) + '\')">' +
          '<div class="bit-hist-info">' +
            '<span class="bit-hist-fecha">' + escHtml(fecha) + ' · ' + escHtml(doc.turno) + '</span>' +
            '<span class="bit-hist-suc">' + escHtml(doc.sucursal) + ' · Cerrada ' + escHtml(cierre) + ' · ' + escHtml(doc.responsable || 'Sin responsable') + '</span>' +
          '</div>' +
          '<div class="bit-hist-res">' +
            '<span class="bit-pill-ok">✓ ' + ok + '</span>' +
            '<span class="bit-pill-falta">↓ ' + falta + '</span>' +
            '<span class="bit-pill-sobra">↑ ' + sobra + '</span>' +
          '</div>' +
        '</div>';
      }).join('');
    })
    .catch(function() {});
}

function bitVerDetalle(id) {
  fetch('/api/bitacora/' + id)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.ok) return;
      var doc  = data.doc;
      var fecha = new Date(doc.fecha).toLocaleDateString('es-MX', { day:'2-digit', month:'long', year:'numeric' });
      var rows = doc.productos.map(function(p) {
        var cls = p.diferencia === 0 ? 'bit-det-ok' : p.diferencia < 0 ? 'bit-det-falta' : 'bit-det-sobra';
        return '<tr class="' + cls + '">' +
          '<td>' + escHtml(p.categoria) + '</td>' +
          '<td>' + escHtml(p.nombre) + '</td>' +
          '<td style="text-align:right">' + p.esperado + '</td>' +
          '<td style="text-align:right">' + p.conteo + '</td>' +
          '<td style="text-align:right;font-weight:600">' + (p.diferencia > 0 ? '+' : '') + p.diferencia + '</td>' +
          '<td>' + escHtml(p.justificacion || '—') + '</td>' +
        '</tr>';
      }).join('');
      document.getElementById('bit-det-titulo').textContent = fecha + ' · ' + doc.turno + ' · ' + doc.sucursal;
      document.getElementById('bit-det-body').innerHTML = rows;
      document.getElementById('bit-det-overlay').classList.remove('bit-det--oculto');
    })
    .catch(function() {});
}

