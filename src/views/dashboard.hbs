<div class="dash-root">

  <!-- ═══════════════════════════════════════════════════════════
       SIDEBAR
       ═══════════════════════════════════════════════════════════ -->
  <aside class="dash-sidebar" id="dash-sidebar">
    <div class="dash-logo">
      <span class="dash-logo-mark">i24h</span>
      <span class="dash-logo-label">Dashboard</span>
    </div>

    <nav class="dash-nav">
      <div class="dash-nav-group">
        <span class="dash-nav-label">Principal</span>
        <a href="/dashboard" class="dash-nav-item dash-nav-item--active">
          <i class="ti ti-layout-dashboard"></i><span>Dashboard</span>
        </a>
        <a href="/panel" class="dash-nav-item">
          <i class="ti ti-grid-dots"></i><span>Panel</span>
        </a>
      </div>
      <div class="dash-nav-group">
        <span class="dash-nav-label">Operaciones</span>
        <a href="/revisiones" class="dash-nav-item">
          <i class="ti ti-clipboard-check"></i><span>Revisiones</span>
        </a>
        <a href="/horarios" class="dash-nav-item">
          <i class="ti ti-calendar-time"></i><span>Horarios</span>
        </a>
      </div>
      <div class="dash-nav-group">
        <span class="dash-nav-label">Sistema</span>
        <a href="/" class="dash-nav-item">
          <i class="ti ti-home"></i><span>Inicio</span>
        </a>
      </div>
    </nav>

    <div class="dash-sidebar-user">
      <div class="dash-user-avatar">{{usuario.nombre.[0]}}</div>
      <div class="dash-user-info">
        <p class="dash-user-name">{{usuario.nombre}}</p>
        <p class="dash-user-role">{{usuario.cargo}}</p>
      </div>
    </div>
  </aside>

  <!-- Fondo oscuro detrás del sidebar cuando está abierto en móvil -->
  <div class="dash-sidebar-fondo" id="dash-sidebar-fondo"></div>

  <!-- ═══════════════════════════════════════════════════════════
       MAIN CONTENT
       ═══════════════════════════════════════════════════════════ -->
  <main class="dash-main">

    <!-- ── Header ───────────────────────────────────────────── -->
    <div class="dash-page-header">
      <div>
        <h1 class="dash-page-title">
          <button class="dash-hamburger" id="dash-hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="dash-sidebar">
            <i class="ti ti-menu-2"></i>
          </button>
          Dashboard
          <span class="dash-pill dash-pill--acento">{{labelPeriodo}}</span>
        </h1>
        <p class="dash-page-sub">{{labelFechas}} · Sync: {{fechaSync}}</p>
      </div>
      <div class="dash-page-actions">
        <button class="dash-btn-o" onclick="window.location.href='/dashboard?sucursal={{sucursalActiva}}&periodo={{periodoActivo}}&turno={{turnoActivo}}'">
          <i class="ti ti-refresh"></i> Actualizar
        </button>
        <button class="dash-btn-o" id="dash-dark-btn">
          <i class="ti ti-moon" id="dash-dark-ico"></i>
        </button>
      </div>
    </div>

    <!-- ── Filtros ───────────────────────────────────────────── -->
    <form class="dash-filtros" method="get" action="/dashboard">
      <input type="hidden" name="dia" value="{{diaFiltro}}">
      <select class="dash-sel" name="sucursal" onchange="this.form.submit()">
        <option value="todas">Todas las sucursales</option>
        {{#each sucursales}}
          <option value="{{nombre}}" {{#if activa}}selected{{/if}}>{{nombre}}</option>
        {{/each}}
      </select>
      <select class="dash-sel" name="periodo" onchange="this.form.submit()">
        <option value="hoy"       {{#if periodoHoy}}selected{{/if}}>Hoy</option>
        <option value="semana"    {{#if periodoSemana}}selected{{/if}}>Esta semana</option>
        <option value="mes"       {{#if periodoMes}}selected{{/if}}>Este mes</option>
        <option value="mes-pasado"{{#if periodoMesPasado}}selected{{/if}}>Mes pasado</option>
        <option value="semestre"  {{#if periodoSemestre}}selected{{/if}}>Últimos 6 meses</option>
      </select>
      <select class="dash-sel" name="turno" onchange="this.form.submit()">
        <option value="todos"  {{#if turnoTodos}}selected{{/if}}>Todos los turnos</option>
        <option value="Turno1" {{#if turnoT1}}selected{{/if}}>Turno 1</option>
        <option value="Turno2" {{#if turnoT2}}selected{{/if}}>Turno 2</option>
        <option value="Turno3" {{#if turnoT3}}selected{{/if}}>Turno 3</option>
      </select>
    </form>

    <!-- ── Días de la semana (solo visible en "Esta semana") ──── -->
    {{#if periodoSemana}}
    <div class="dash-dias-semana">
      <a href="/dashboard?sucursal={{sucursalActiva}}&periodo=semana&turno={{turnoActivo}}&dia=todos"
         class="dash-dia-btn{{#unless diaActivo}} dash-dia-btn--activo{{/unless}}">Todos</a>
      {{#each diasSemana}}
      <a href="/dashboard?sucursal={{../sucursalActiva}}&periodo=semana&turno={{../turnoActivo}}&dia={{fecha}}"
         class="dash-dia-btn{{#if activo}} dash-dia-btn--activo{{/if}}">{{nombre}}</a>
      {{/each}}
    </div>
    {{/if}}

    <!-- ── 4 KPIs ────────────────────────────────────────────── -->
    <div class="dash-kpi-grid">
      <div class="dash-kpi">
        <div class="dash-kpi-label"><i class="ti ti-cash"></i> Venta total</div>
        <div class="dash-kpi-valor">{{ventaTotalFmt}}</div>
        <div class="dash-kpi-sub">{{labelPeriodo}}</div>
      </div>
      <div class="dash-kpi">
        <div class="dash-kpi-label"><i class="ti ti-receipt"></i> Tickets</div>
        <div class="dash-kpi-valor">{{totalTickets}}</div>
        <div class="dash-kpi-sub">{{labelFechas}}</div>
      </div>
      <div class="dash-kpi">
        <div class="dash-kpi-label"><i class="ti ti-users"></i> Empleados activos</div>
        <div class="dash-kpi-valor">{{empleadosCount}}</div>
        <div class="dash-kpi-sub">En todas las sucursales</div>
      </div>
      <div class="dash-kpi">
        <div class="dash-kpi-label"><i class="ti ti-building-store"></i> Sucursal</div>
        <div class="dash-kpi-valor" style="font-size:1rem">{{sucursalActiva}}</div>
        <div class="dash-kpi-sub">Filtro activo</div>
      </div>
    </div>

    <!-- ── Gráfica de ventas diarias ─────────────────────────── -->
    <p class="dash-sec-titulo"><i class="ti ti-chart-bar"></i> Venta diaria</p>
    <div class="dash-card dash-chart-card">
      <canvas id="chartVentas" height="220"></canvas>
    </div>

    <!-- ── Turnos ────────────────────────────────────────────── -->
    <p class="dash-sec-titulo"><i class="ti ti-clock"></i> Recaudación por turno (promedio diario)</p>
    <div class="dash-turno-grid">
      {{#if hayTurnos}}
        <div class="dash-turno-card dash-turno-t1">
          <div><div class="dash-turno-lbl">{{turnosData.T1.label}}</div><div class="dash-turno-hora">Turno 1 · 7:00 – 3:30</div></div>
          <div class="dash-turno-val">{{turnosData.T1.promedio}}</div>
        </div>
        <div class="dash-turno-card dash-turno-t2">
          <div><div class="dash-turno-lbl">{{turnosData.T2.label}}</div><div class="dash-turno-hora">Turno 2 · 2:00 – 10:30</div></div>
          <div class="dash-turno-val">{{turnosData.T2.promedio}}</div>
        </div>
        <div class="dash-turno-card dash-turno-t3">
          <div><div class="dash-turno-lbl">{{turnosData.T3.label}}</div><div class="dash-turno-hora">Turno 3 · 10:00 – 7:00</div></div>
          <div class="dash-turno-val">{{turnosData.T3.promedio}}</div>
        </div>
      {{else}}
        <div class="dash-turno-card dash-turno-t1">
          <div><div class="dash-turno-lbl">Turno 1</div><div class="dash-turno-hora">7:00 am – 3:30 pm</div></div>
          <div class="dash-turno-val dash-sin-datos">Sin datos</div>
        </div>
        <div class="dash-turno-card dash-turno-t2">
          <div><div class="dash-turno-lbl">Turno 2</div><div class="dash-turno-hora">2:00 pm – 10:30 pm</div></div>
          <div class="dash-turno-val dash-sin-datos">Sin datos</div>
        </div>
        <div class="dash-turno-card dash-turno-t3">
          <div><div class="dash-turno-lbl">Turno 3</div><div class="dash-turno-hora">10:00 pm – 7:00 am</div></div>
          <div class="dash-turno-val dash-sin-datos">Sin datos</div>
        </div>
      {{/if}}
    </div>

    <!-- ── Grid 2 col: Productos + Concepto ──────────────────── -->
    <div class="dash-grid-2">

      <!-- Top productos -->
      <div class="dash-card">
        <div class="dash-card-hdr">
          <p class="dash-card-titulo"><i class="ti ti-star"></i> Top productos (unidades)</p>
          <a href="/panel" class="dash-link-btn">Ver ventas</a>
        </div>
        {{#if hayProductos}}
          {{#each topProductos}}
            <div class="dash-prod-fila">
              <div class="dash-prod-info">
                <div class="dash-prod-nombre">{{nombre}}</div>
              </div>
              <div class="dash-prod-uds">{{unidades}} uds</div>
              <div class="dash-prod-monto">{{montoFmt}}</div>
            </div>
          {{/each}}
        {{else}}
          <div class="dash-empty-state"><i class="ti ti-package-off"></i> Sin registros en el período</div>
        {{/if}}
      </div>

      <!-- Venta por concepto -->
      <div class="dash-card">
        <div class="dash-card-hdr">
          <p class="dash-card-titulo"><i class="ti ti-chart-pie"></i> Venta por categoría</p>
        </div>
        {{#if hayCategorias}}
          {{#each ventaCategoria}}
            <div class="dash-barra-fila">
              <div class="dash-barra-label">{{categoria}}</div>
              <div class="dash-barra-track">
                <div class="dash-barra-fill" style="width:{{barWidth}}%"></div>
              </div>
              <div class="dash-barra-valor">{{totalFmt}}</div>
            </div>
          {{/each}}
        {{else}}
          <div class="dash-empty-state"><i class="ti ti-chart-off"></i> Sin datos de ventas</div>
        {{/if}}
      </div>
    </div>

    <!-- ── Inventario de material (tabla completa) ───────────── -->
    <div class="dash-card" style="margin-bottom:1.5rem">
      <div class="dash-card-hdr">
        <p class="dash-card-titulo"><i class="ti ti-package"></i> Inventario de material</p>
        <div class="dash-inv-badges">
          <span class="dash-pill dash-pill--exito">{{stockResumen.ok}} OK</span>
          {{#if stockResumen.bajos}}<span class="dash-pill dash-pill--alerta">{{stockResumen.bajos}} Bajos</span>{{/if}}
          {{#if stockResumen.agotados}}<span class="dash-pill dash-pill--peligro">{{stockResumen.agotados}} Agotados</span>{{/if}}
        </div>
      </div>
      {{#if hayStock}}
        <div class="dash-inv-scroll">
          <table class="dash-inv-tabla">
            <thead>
              <tr>
                <th>Producto</th>
                <th class="dash-inv-num">Precio</th>
                <th class="dash-inv-num">Stock</th>
                <th class="dash-inv-num">Mínimo</th>
                <th class="dash-inv-estado">Estado</th>
              </tr>
            </thead>
            <tbody>
              {{#each stockProductos}}
                <tr class="dash-inv-row {{rowClase}}">
                  <td class="dash-inv-nombre">{{nombre}}</td>
                  <td class="dash-inv-num">${{precio}}</td>
                  <td class="dash-inv-num dash-inv-stock-val">{{stock}}</td>
                  <td class="dash-inv-num">{{minimo}}</td>
                  <td class="dash-inv-estado">
                    <span class="dash-pill dash-pill--{{estadoClase}}">{{estadoLabel}}</span>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="dash-empty-state"><i class="ti ti-package-off"></i> Sin datos de inventario — sincroniza primero</div>
      {{/if}}
    </div>

    <!-- ── Revisiones pendientes ──────────────────────────────── -->
    <div class="dash-card" style="margin-bottom:2rem">
      <div class="dash-card-hdr">
        <p class="dash-card-titulo"><i class="ti ti-clipboard-check"></i> Revisiones pendientes / cobrables</p>
        <a href="/revisiones" class="dash-link-btn">Ver todas</a>
      </div>
      {{#if hayRevisiones}}
        {{#each revisionesPend}}
          <div class="dash-rev-fila">
            <div class="dash-rev-info">
              <span class="dash-pill {{#if esCobrable}}dash-pill--peligro{{else}}dash-pill--alerta{{/if}}">
                {{#if esCobrable}}Cobrable{{else}}Pendiente{{/if}}
              </span>
              <span class="dash-rev-suc">{{sucursal}}</span>
              <span class="dash-rev-det">Caja #{{ncaja}} · {{turno}}</span>
            </div>
            <span class="dash-rev-dif">Dif: {{diferenciaTotal}}</span>
          </div>
        {{/each}}
      {{else}}
        <div class="dash-empty-state"><i class="ti ti-circle-check"></i> Sin revisiones pendientes</div>
      {{/if}}
    </div>

    <!-- ── Tabs: Venta sin material/snack/novedades + Tickets I24H ──── -->
    <div class="dash-card" style="margin-bottom:2rem">
      <div class="dash-tabs">
        <button type="button" class="dash-tab-btn dash-tab-btn--activo" data-tab="mat">VENTA SIN MATERIAL SNACK Y NOVEDADES</button>
        <button type="button" class="dash-tab-btn" data-tab="tkt">Tickets I24H</button>
      </div>

      <!-- Tab: venta sin material/snack/novedades -->
      <div class="dash-tab-panel" id="tab-mat">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
          <select class="dash-sel" id="mat-suc" style="min-width:160px">
            {{#each sucursales}}
              <option value="{{nombre}}" {{#if activa}}selected{{/if}}>{{nombre}}</option>
            {{/each}}
          </select>
          <input type="date" class="dash-sel" id="mat-fecha" style="max-width:155px">
          <button class="dash-btn-o" id="mat-btn" style="gap:6px">
            <i class="ti ti-search"></i> Consultar
          </button>
          <span id="mat-resumen" style="font-size:.82rem;color:var(--d-tex-suave)"></span>
        </div>
        <div style="overflow-x:auto;max-height:320px;overflow-y:auto">
          <table class="dash-inv-tabla" id="mat-tabla" style="width:100%">
            <thead>
              <tr>
                <th style="text-align:left">Caja / Turno</th>
                <th style="text-align:left">Producto</th>
                <th style="text-align:right">Unidades</th>
                <th style="text-align:right">Importe</th>
              </tr>
            </thead>
            <tbody id="mat-body">
              <tr><td colspan="4" style="text-align:center;padding:20px;color:var(--d-tex-suave)">Selecciona sucursal y fecha, luego presiona Consultar.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tab: Tickets I24H -->
      <div class="dash-tab-panel dash-tab-panel--oculto" id="tab-tkt">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
          <select class="dash-sel" id="tkt-suc" style="min-width:160px">
            {{#each sucursales}}
              <option value="{{nombre}}" {{#if activa}}selected{{/if}}>{{nombre}}</option>
            {{/each}}
          </select>
          <input type="date" class="dash-sel" id="tkt-fecha" style="max-width:155px">
          <button class="dash-btn-o" id="tkt-btn" style="gap:6px">
            <i class="ti ti-search"></i> Buscar
          </button>
          <input type="text" class="dash-sel" id="tkt-filtro" placeholder="Filtrar por # de ticket" style="max-width:180px" disabled>
          <span id="tkt-resumen" style="font-size:.82rem;color:var(--d-tex-suave)"></span>
        </div>
        <div style="overflow-x:auto;max-height:420px;overflow-y:auto">
          <table class="dash-inv-tabla" id="tkt-tabla" style="width:100%">
            <thead>
              <tr>
                <th style="text-align:left">Ticket #</th>
                <th style="text-align:left">Turno</th>
                <th style="text-align:left">Hora</th>
                <th style="text-align:right">Importe</th>
                <th style="text-align:right">Descontado</th>
                <th style="text-align:left">{{#if esAdmin}}Ajuste{{/if}}</th>
              </tr>
            </thead>
            <tbody id="tkt-body">
              <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--d-tex-suave)">Selecciona sucursal y fecha, luego presiona Buscar.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

<script>window.DASH_ES_ADMIN = {{#if esAdmin}}true{{else}}false{{/if}};</script>

<!-- Datos para Chart.js (embebidos en el HTML, leídos por dashboard.js) -->
<script>window.DASH_DATA = {{{dashJson}}};</script>
<!-- Chart.js — debe cargarse ANTES de dashboard.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
(function () {
  var hoyMx = new Date(Date.now() - 6 * 60 * 60 * 1000).toISOString().split('T')[0];

  function fmt(n) {
    return '$' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function clear(node) { while (node && node.firstChild) node.removeChild(node.firstChild); }
  function el(tag, opts) {
    var e = document.createElement(tag);
    opts = opts || {};
    if (opts.text != null) e.textContent = opts.text;
    if (opts.className) e.className = opts.className;
    if (opts.style) e.setAttribute('style', opts.style);
    if (opts.attrs) Object.keys(opts.attrs).forEach(function (k) { e.setAttribute(k, opts.attrs[k]); });
    if (opts.dataset) Object.keys(opts.dataset).forEach(function (k) { e.dataset[k] = opts.dataset[k]; });
    (opts.children || []).forEach(function (c) { if (c) e.appendChild(c); });
    return e;
  }
  function td(content, style) {
    var d = document.createElement('td');
    if (style) d.setAttribute('style', style);
    if (content instanceof Node) d.appendChild(content);
    else d.textContent = content == null ? '' : String(content);
    return d;
  }
  function msgRow(body, text, colspan, color) {
    clear(body);
    var d = td(text, 'text-align:center;padding:20px' + (color ? ';color:' + color : ''));
    d.colSpan = colspan;
    body.appendChild(el('tr', { children: [d] }));
  }

  // ── Tabs ──────────────────────────────────────────────────────────
  var tabBtns   = document.querySelectorAll('.dash-tab-btn');
  var tabPanels = { mat: document.getElementById('tab-mat'), tkt: document.getElementById('tab-tkt') };
  tabBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      tabBtns.forEach(function (x) { x.classList.remove('dash-tab-btn--activo'); });
      b.classList.add('dash-tab-btn--activo');
      Object.keys(tabPanels).forEach(function (k) {
        tabPanels[k].classList.toggle('dash-tab-panel--oculto', k !== b.dataset.tab);
      });
    });
  });

  // ── Tab: Venta sin material, snack y novedades ──────────────────────
  (function () {
    var btn     = document.getElementById('mat-btn');
    var sucSel  = document.getElementById('mat-suc');
    var fechaIn = document.getElementById('mat-fecha');
    var body    = document.getElementById('mat-body');
    var resumen = document.getElementById('mat-resumen');
    if (fechaIn) fechaIn.value = hoyMx;

    function consultar() {
      if (!body) return;
      var suc = sucSel ? sucSel.value : '', fecha = fechaIn ? fechaIn.value : '';
      msgRow(body, 'Consultando…', 4);
      if (resumen) clear(resumen);

      fetch('/api/material/resumen?sucursal=' + encodeURIComponent(suc) + '&fecha=' + encodeURIComponent(fecha))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) { msgRow(body, 'Error: ' + (d.error || 'desconocido'), 4, '#f87171'); return; }
          if (resumen) {
            clear(resumen);
            resumen.appendChild(el('strong', { text: 'Total excluido: ' }));
            resumen.appendChild(document.createTextNode(fmt(d.totalMaterial)));
          }
          if (!d.filas || d.filas.length === 0) {
            msgRow(body, 'Sin ventas de material/snack/novedades para esa fecha y sucursal.', 4, 'var(--d-tex-suave)');
            return;
          }
          clear(body);
          d.filas.forEach(function (g) {
            body.appendChild(el('tr', {
              style: 'font-weight:600;background:var(--d-fondo-alt)',
              children: [
                td('Caja ' + (g.ncaja != null ? g.ncaja : '—') + ' · ' + (g.turno || '—')),
                td(''),
                td(g.unidades + ' uds', 'text-align:right'),
                td(fmt(g.importe), 'text-align:right'),
              ],
            }));
            (g.productos || []).forEach(function (p) {
              body.appendChild(el('tr', { children: [td(''), td(p.nombre), td(''), td(fmt(p.importe), 'text-align:right')] }));
            });
          });
        })
        .catch(function (err) { msgRow(body, 'Error de red: ' + err.message, 4, '#f87171'); });
    }
    if (btn) btn.addEventListener('click', consultar);
  })();

  // ── Tab: Tickets I24H ───────────────────────────────────────────────
  (function () {
    var btn      = document.getElementById('tkt-btn');
    var sucSel   = document.getElementById('tkt-suc');
    var fechaIn  = document.getElementById('tkt-fecha');
    var filtroIn = document.getElementById('tkt-filtro');
    var body     = document.getElementById('tkt-body');
    var resumen  = document.getElementById('tkt-resumen');
    var esAdmin  = window.DASH_ES_ADMIN === true;
    var cache    = [];
    var sucursalActual = '';

    if (fechaIn) fechaIn.value = hoyMx;

    function ajusteFila(a) {
      var confirmSpan = el('span', {
        className: 'dash-ajuste-confirm', style: 'display:none',
        children: [
          document.createTextNode('¿Seguro? '),
          el('button', { text: 'Sí', attrs: { type: 'button' }, dataset: { action: 'del-yes', id: a._id, nticket: '' } }),
          document.createTextNode(' '),
          el('button', { text: 'No', attrs: { type: 'button' }, dataset: { action: 'del-no' } }),
        ],
      });
      var children = [el('span', { text: fmt(a.montoDescontado) + ' — ' + a.motivo })];
      if (esAdmin) {
        var trashIcon = el('i', { className: 'ti ti-trash' });
        var delBtn = el('button', {
          className: 'dash-tacha-btn', attrs: { type: 'button', title: 'Eliminar ajuste' },
          dataset: { action: 'del-ask', id: a._id }, children: [trashIcon],
        });
        children.push(document.createTextNode(' '), delBtn, confirmSpan);
      }
      return el('div', { className: 'dash-ajuste-fila', dataset: { ajusteId: a._id }, children: children });
    }

    function accionCell(t) {
      var container = el('div', { children: (t.ajustes || []).map(ajusteFila) });
      if (esAdmin) {
        var toggleBtn = el('button', {
          text: 'Descontar', className: 'dash-btn-o', style: 'font-size:12px;padding:4px 10px',
          attrs: { type: 'button' }, dataset: { action: 'toggle-form', nticket: t.nticket },
        });
        var montoIn  = el('input', { attrs: { type: 'number', min: '0.01', step: '0.01', placeholder: 'Monto' }, className: 'dash-sel', style: 'width:100px', dataset: {} });
        montoIn.id = 'monto-' + t.nticket;
        var motivoIn = el('input', { attrs: { type: 'text', maxlength: '300', placeholder: 'Motivo' }, className: 'dash-sel', style: 'width:180px' });
        motivoIn.id = 'motivo-' + t.nticket;
        var aplicarBtn = el('button', {
          text: 'Aplicar', className: 'dash-btn-p', style: 'font-size:12px;padding:4px 10px',
          attrs: { type: 'button' }, dataset: { action: 'aplicar', nticket: t.nticket },
        });
        var errDiv = el('div', { className: 'dash-ajuste-error', style: 'color:#f87171;font-size:12px;margin-top:4px' });
        errDiv.id = 'err-' + t.nticket;
        var form = el('div', {
          className: 'dash-ajuste-form', style: 'display:none;margin-top:8px',
          children: [montoIn, motivoIn, aplicarBtn, errDiv],
        });
        form.id = 'form-' + t.nticket;
        container.appendChild(toggleBtn);
        container.appendChild(form);
      }
      return container;
    }

    function ticketRow(t) {
      var ntCell = document.createElement('td');
      ntCell.appendChild(document.createTextNode(String(t.nticket) + ' '));
      if (t.ncaja != null) ntCell.appendChild(el('span', { style: 'color:var(--d-tex-suave)', text: '(Caja ' + t.ncaja + ')' }));
      var row = el('tr', {
        dataset: { nticket: t.nticket },
        children: [
          ntCell,
          td(t.turno || '—'),
          td(t.hora || '—'),
          td(fmt(t.importeTotal), 'text-align:right'),
          td(fmt(t.totalDescontado), 'text-align:right'),
          td(accionCell(t)),
        ],
      });
      return row;
    }

    function render(lista) {
      if (!body) return;
      clear(body);
      if (!lista.length) { msgRow(body, 'Sin tickets para esa fecha y sucursal.', 6, 'var(--d-tex-suave)'); return; }
      lista.forEach(function (t) { body.appendChild(ticketRow(t)); });
    }

    function buscar() {
      if (!body) return;
      sucursalActual = sucSel ? sucSel.value : '';
      var fecha = fechaIn ? fechaIn.value : '';
      msgRow(body, 'Buscando…', 6);
      if (resumen) clear(resumen);
      if (filtroIn) { filtroIn.value = ''; filtroIn.disabled = true; }

      fetch('/api/material/tickets-dia?sucursal=' + encodeURIComponent(sucursalActual) + '&fecha=' + encodeURIComponent(fecha))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) { msgRow(body, 'Error: ' + (d.error || 'desconocido'), 6, '#f87171'); return; }
          cache = d.tickets || [];
          if (resumen) {
            clear(resumen);
            resumen.appendChild(el('strong', { text: d.numTickets + ' tickets' }));
            resumen.appendChild(document.createTextNode(' · Total: '));
            resumen.appendChild(el('strong', { text: fmt(d.total) }));
          }
          if (filtroIn) filtroIn.disabled = false;
          render(cache);
        })
        .catch(function (err) { msgRow(body, 'Error de red: ' + err.message, 6, '#f87171'); });
    }

    if (btn) btn.addEventListener('click', buscar);
    if (filtroIn) {
      filtroIn.addEventListener('input', function () {
        var q = filtroIn.value.trim();
        render(q ? cache.filter(function (t) { return String(t.nticket).indexOf(q) !== -1; }) : cache);
      });
    }

    if (body) {
      body.addEventListener('click', function (ev) {
        var target = ev.target.closest('[data-action]');
        if (!target) return;
        var action = target.dataset.action;

        if (action === 'toggle-form') {
          var form = document.getElementById('form-' + target.dataset.nticket);
          if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        if (action === 'aplicar') {
          var nt = target.dataset.nticket;
          var monto  = document.getElementById('monto-' + nt);
          var motivo = document.getElementById('motivo-' + nt);
          var errEl  = document.getElementById('err-' + nt);
          if (errEl) errEl.textContent = '';
          target.disabled = true;
          fetch('/api/material/ajuste-ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nticket: nt, sucursal: sucursalActual,
              montoDescontado: monto ? monto.value : '', motivo: motivo ? motivo.value : '',
            }),
          })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              target.disabled = false;
              if (!d.ok) { if (errEl) errEl.textContent = d.error || 'Error al aplicar el descuento'; return; }
              buscar();
            })
            .catch(function (err) {
              target.disabled = false;
              if (errEl) errEl.textContent = 'Error de red: ' + err.message;
            });
        }

        if (action === 'del-ask') {
          var fila = target.closest('.dash-ajuste-fila');
          if (fila) fila.querySelector('.dash-ajuste-confirm').style.display = 'inline';
        }
        if (action === 'del-no') {
          var fila2 = target.closest('.dash-ajuste-fila');
          if (fila2) fila2.querySelector('.dash-ajuste-confirm').style.display = 'none';
        }
        if (action === 'del-yes') {
          target.disabled = true;
          fetch('/api/material/ajuste-ticket/' + target.dataset.id, { method: 'DELETE' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (!d.ok) { target.disabled = false; return; }
              buscar();
            })
            .catch(function () { target.disabled = false; });
        }
      });
    }
  })();
})();
</script>
