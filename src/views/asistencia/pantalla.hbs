<div class="as-kiosco">
  <div class="as-kiosco-card">
    <div class="as-kiosco-suc">{{sucursal}}</div>
    <img class="as-kiosco-qr" src="{{qrDataUrl}}" alt="Código QR de asistencia">
    <div class="as-kiosco-hint">
      <i class="ti ti-scan"></i>
      Escaneá con la cámara de tu teléfono para marcar entrada / salida
    </div>
    <div class="as-kiosco-refresh">El código se renueva solo cada 25 segundos</div>
  </div>
</div>

<script>
  // La pantalla se recarga sola para pedir un token nuevo antes de que
  // venza el actual — así el QR en pantalla siempre está vigente.
  setTimeout(function () { window.location.reload(); }, {{refrescarMs}});
</script>
